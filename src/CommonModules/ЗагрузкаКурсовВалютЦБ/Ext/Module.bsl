///////////////////////////////////////////////////////////////////////////////////
// Общий модуль "ЗагрузкаКурсовВалютЦБ"
//
// Механизм загрузки курсов валют с сайта ЦБ РФ (https://www.cbr.ru).
// Состав модуля:
//   * ПолучитьДанныеСервиса    - HTTP-запрос с таймаутом и повторными попытками;
//   * РазобратьОтветСервиса    - разбор XML в таблицу значений;
//   * ЗаписатьКурсыВРегистр    - запись в регистр сведений КурсыВалют;
//   * ВыполнитьЗагрузку        - сценарий целиком (используется точкой входа).
//
// Точка входа регламентного задания вынесена в модуль
// ЗагрузкаКурсовВалютЦБРегламентноеЗадание.
//
// Флаги общего модуля:
//   Клиент (управляемое приложение) = Ложь
//   Сервер                          = Истина
//   Внешнее соединение              = Истина
//   Вызов сервера                   = Ложь
//   Привилегированный               = Ложь
///////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Выполняет полный сценарий загрузки: запрос к сервису, разбор ответа и запись
// в регистр сведений КурсыВалют. Исключения наружу не выбрасываются: любая
// ошибка фиксируется в журнале регистрации и отражается в результате.
//
// Параметры:
//  Знач ПараметрыЗагрузки - Структура, Неопределено - параметры выполнения:
//   * ТолькоЗагружаемыеВалюты - Булево - записывать курсы только тех валют, у которых
//                                        установлен признак ЗагружаетсяИзИнтернета.
//                                        По умолчанию Истина.
//   * ДатаКурса               - Дата, Неопределено - дата, на которую записывать курсы.
//                                        По умолчанию берется из ответа сервиса.
//
// Возвращаемое значение:
//  Структура - результат выполнения:
//   * Успешно          - Булево - Истина, если данные получены, разобраны и записаны.
//   * ДатаКурса        - Дата   - дата курсов из ответа сервиса.
//   * ВсегоПолучено    - Число  - количество элементов в ответе сервиса.
//   * Записано         - Число  - количество записанных наборов записей.
//   * Пропущено        - Число  - количество пропущенных элементов.
//   * ОписаниеОшибки   - Строка - текст ошибки, если Успешно = Ложь.
//
// Пример:
//  Результат = ЗагрузкаКурсовВалютЦБ.ВыполнитьЗагрузку();
//
Функция ВыполнитьЗагрузку(Знач ПараметрыЗагрузки = Неопределено) Экспорт

	НачалоВыполнения = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ВидыСбоев = ЗагрузкаКурсовВалютЦБКлиентСервер.ВидыСбоев();

	Результат = Новый Структура;
	Результат.Вставить("Успешно",        Ложь);
	Результат.Вставить("ДатаКурса",      '00010101');
	Результат.Вставить("ВсегоПолучено",  0);
	Результат.Вставить("Записано",       0);
	Результат.Вставить("Пропущено",      0);
	Результат.Вставить("НеЗаписано",     0);
	Результат.Вставить("ОписаниеОшибки", "");
	Результат.Вставить("ВидСбоя",        ВидыСбоев.Нет);
	Результат.Вставить("ТребуетВнимания", Ложь);

	// <validation> Нормализация входных параметров - not delete
	Параметры = Новый Структура;
	Параметры.Вставить("ТолькоЗагружаемыеВалюты", Истина);
	Параметры.Вставить("ДатаКурса",               Неопределено);
	Если ТипЗнч(ПараметрыЗагрузки) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Параметры, ПараметрыЗагрузки);
	КонецЕсли;
	// </validation>

	// <processing> Шаг 1. Получение данных от сервиса
	ОтветСервиса = ПолучитьДанныеСервиса();
	Если Не ОтветСервиса.Успешно Тогда
		Результат.ВидСбоя         = ОтветСервиса.ВидСбоя;
		Результат.ОписаниеОшибки  = ОтветСервиса.ОписаниеОшибки;
		Результат.ТребуетВнимания =
			ЗагрузкаКурсовВалютЦБКлиентСервер.РеакцияНаСбой(ОтветСервиса.ВидСбоя).ТребуетВнимания;
		Возврат Результат;
	КонецЕсли;
	// </processing>

	// <processing> Шаг 2. Разбор ответа
	ДанныеРазбора = РазобратьОтветСервиса(ОтветСервиса.Содержимое);
	Если Не ДанныеРазбора.Успешно Тогда
		Результат.ВидСбоя         = ДанныеРазбора.ВидСбоя;
		Результат.ОписаниеОшибки  = ДанныеРазбора.ОписаниеОшибки;
		Результат.ТребуетВнимания =
			ЗагрузкаКурсовВалютЦБКлиентСервер.РеакцияНаСбой(ДанныеРазбора.ВидСбоя).ТребуетВнимания;
		Возврат Результат;
	КонецЕсли;

	Результат.ДатаКурса     = ДанныеРазбора.ДатаКурса;
	Результат.ВсегоПолучено = ДанныеРазбора.Курсы.Количество();
	Результат.Пропущено     = ДанныеРазбора.Пропущено;
	// </processing>

	Если Параметры.ДатаКурса <> Неопределено Тогда
		Результат.ДатаКурса = НачалоДня(Параметры.ДатаКурса);
	КонецЕсли;

	// <processing> Шаг 3. Запись в регистр сведений
	ПараметрыЗаписи = Новый Структура;
	ПараметрыЗаписи.Вставить("ДатаКурса",                Результат.ДатаКурса);
	ПараметрыЗаписи.Вставить("ТолькоЗагружаемыеВалюты",  Параметры.ТолькоЗагружаемыеВалюты);

	РезультатЗаписи = ЗаписатьКурсыВРегистр(ДанныеРазбора.Курсы, ПараметрыЗаписи);

	Результат.Записано   = РезультатЗаписи.Записано;
	Результат.НеЗаписано = РезультатЗаписи.НеЗаписано;
	Результат.Пропущено  = Результат.Пропущено + РезультатЗаписи.Пропущено;

	Если Не РезультатЗаписи.Успешно Тогда
		Результат.ВидСбоя         = РезультатЗаписи.ВидСбоя;
		Результат.ОписаниеОшибки  = РезультатЗаписи.ОписаниеОшибки;
		Результат.ТребуетВнимания =
			ЗагрузкаКурсовВалютЦБКлиентСервер.РеакцияНаСбой(РезультатЗаписи.ВидСбоя).ТребуетВнимания;
		Возврат Результат;
	КонецЕсли;

	Результат.Успешно = Истина;

	// Загрузка состоялась, но с оговорками: часть данных отбракована или не записана.
	// Итог успешный (курсы в базе обновлены), однако сбой виден в результате и журнале.
	Если РезультатЗаписи.НеЗаписано > 0 Тогда
		Результат.ВидСбоя = ВидыСбоев.ОшибкаЗаписи;
	ИначеЕсли ДанныеРазбора.Пропущено > 0 Тогда
		Результат.ВидСбоя = ВидыСбоев.НеполныеДанные;
	КонецЕсли;

	Результат.ТребуетВнимания =
		ЗагрузкаКурсовВалютЦБКлиентСервер.РеакцияНаСбой(Результат.ВидСбоя).ТребуетВнимания;
	// </processing>

	// <log> Успешное выполнение логируется всегда - иначе молчание механизма
	// неотличимо от его остановки - not delete
	Длительность = (ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВыполнения) / 1000;

	Если Результат.ВидСбоя = ВидыСбоев.Нет Тогда
		Итог = НСтр("ru = 'Загрузка курсов валют выполнена успешно.'");
		Уровень = УровеньЖурналаРегистрации.Информация;
	Иначе
		Итог = НСтр("ru = 'Загрузка курсов валют выполнена частично: курсы в базе обновлены,
			|но часть данных не загружена (подробности - в записях выше).'");
		Уровень = УровеньЖурналаРегистрации.Предупреждение;
	КонецЕсли;

	ЗаписатьВЖурнал(
		Уровень,
		СтрШаблон(
			НСтр("ru = '%1
				|
				|Дата курсов: %2
				|Получено от сервиса: %3
				|Записано в регистр: %4
				|Не сопоставлено со справочником: %5
				|Не записано из-за ошибок: %6
				|Длительность, с: %7'"),
			Итог,
			Формат(Результат.ДатаКурса, "ДФ=dd.MM.yyyy"),
			Формат(Результат.ВсегоПолучено, "ЧГ=0"),
			Формат(Результат.Записано,      "ЧГ=0"),
			Формат(Результат.Пропущено,     "ЧГ=0"),
			Формат(Результат.НеЗаписано,    "ЧГ=0"),
			Формат(Длительность, "ЧДЦ=3; ЧГ=0")));
	// </log>

	Возврат Результат;

КонецФункции

// Получает данные от сервиса ЦБ РФ. Выполняет заданное число попыток с паузой
// между ними. Исключения наружу не выбрасываются.
//
// Возвращаемое значение:
//  Структура - результат запроса:
//   * Успешно        - Булево - Истина, если получен непустой ответ с кодом 200.
//   * Содержимое     - ДвоичныеДанные, Неопределено - тело ответа "как есть",
//                      без преобразования в строку: кодировку определяет разбор.
//   * КодСостояния   - Число  - код состояния последнего ответа, 0 - соединения не было.
//   * ОписаниеОшибки - Строка - текст ошибки, если Успешно = Ложь.
//
// Пример:
//  Ответ = ЗагрузкаКурсовВалютЦБ.ПолучитьДанныеСервиса();
//
Функция ПолучитьДанныеСервиса() Экспорт

	ВидыСбоев = ЗагрузкаКурсовВалютЦБКлиентСервер.ВидыСбоев();

	Результат = Новый Структура;
	Результат.Вставить("Успешно",        Ложь);
	Результат.Вставить("Содержимое",     Неопределено);
	Результат.Вставить("КодСостояния",   0);
	Результат.Вставить("ОписаниеОшибки", "");
	Результат.Вставить("ВидСбоя",        ВидыСбоев.Сеть);
	Результат.Вставить("ВыполненоПопыток", 0);

	Параметры = ПараметрыПодключения();

	// Сервис отдает весь пакет курсов одним запросом, поэтому запрос выполняется
	// однократно на всю загрузку, а не в цикле по валютам.
	ПоследняяОшибка = "";

	Для НомерПопытки = 1 По Параметры.КоличествоПопыток Цикл

		Результат.ВыполненоПопыток = НомерПопытки;

		// <error> Каждая попытка изолирована: сетевая ошибка не прерывает задание - not delete
		Попытка
			ОтветПопытки = ВыполнитьЗапросКСервису(Параметры);
		Исключение
			// Соединение не состоялось: недоступность сети, DNS, TLS или таймаут.
			// Код состояния платформа в этом случае не возвращает, поэтому вид сбоя
			// определяем по тексту: таймаут и обрыв сети требуют разной реакции.
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);

			ОтветПопытки = Новый Структура(
				"Успешно, Содержимое, КодСостояния, ОписаниеОшибки, ВидСбоя",
				Ложь,
				Неопределено,
				0,
				ТекстОшибки,
				ЗагрузкаКурсовВалютЦБКлиентСервер.ВидСбояПоТекстуОшибки(ТекстОшибки));
		КонецПопытки;
		// </error>

		Результат.КодСостояния = ОтветПопытки.КодСостояния;
		Результат.ВидСбоя      = ОтветПопытки.ВидСбоя;

		Если ОтветПопытки.Успешно Тогда
			Результат.Успешно    = Истина;
			Результат.Содержимое = ОтветПопытки.Содержимое;
			Результат.ВидСбоя    = ВидыСбоев.Нет;

			Если НомерПопытки > 1 Тогда
				// Фиксируем, что данные получены только после повторов - это признак
				// нестабильности канала, полезный при разборе инцидентов.
				ЗаписатьВЖурнал(
					УровеньЖурналаРегистрации.Информация,
					СтрШаблон(НСтр("ru = 'Данные получены с попытки %1 из %2.
						|Канал связи или сервис работают нестабильно.'"),
						НомерПопытки, Параметры.КоличествоПопыток));
			КонецЕсли;

			Возврат Результат;
		КонецЕсли;

		ПоследняяОшибка = ОтветПопытки.ОписаниеОшибки;
		Реакция = ЗагрузкаКурсовВалютЦБКлиентСервер.РеакцияНаСбой(ОтветПопытки.ВидСбоя);

		// Повторять имеет смысл только там, где повтор способен изменить результат:
		// сеть, таймаут, 5xx, 429. На 4xx сервис ответит так же - повтор запрещен.
		БудетПовтор = Реакция.Повторять И НомерПопытки < Параметры.КоличествоПопыток;

		// <log> Каждая неудачная попытка попадает в журнал регистрации - not delete
		// Промежуточная попытка перед повтором - Предупреждение: это еще не инцидент.
		// Если повтора не будет, итоговую запись сделает код после цикла.
		ЗаписатьВЖурнал(
			?(БудетПовтор,
				УровеньЖурналаРегистрации.Предупреждение,
				УровеньЖурналаРегистрации.Информация),
			СтрШаблон(
				НСтр("ru = 'Попытка %1 из %2 завершилась неудачей.
					|Вид сбоя: %3
					|Адрес: %4
					|Код состояния: %5
					|Действие: %6
					|Диагностика: %7'"),
				НомерПопытки,
				Параметры.КоличествоПопыток,
				ОтветПопытки.ВидСбоя,
				БезопасныйАдресДляЖурнала(Параметры),
				?(ОтветПопытки.КодСостояния = 0,
					НСтр("ru = 'соединение не установлено'"),
					Формат(ОтветПопытки.КодСостояния, "ЧГ=0")),
				?(БудетПовтор, Реакция.Действие, НСтр("ru = 'Попытки исчерпаны либо повтор бессмыслен.'")),
				ПоследняяОшибка));
		// </log>

		Если Не Реакция.Повторять Тогда
			Прервать;
		КонецЕсли;

		Если БудетПовтор Тогда
			// Пауза растет с номером попытки и содержит случайную добавку.
			// Рост нужен, чтобы не долбить сервис; случайная добавка - чтобы
			// несколько баз с общим расписанием не обращались синхронно.
			ВыполнитьПаузуПередПовтором(Параметры, НомерПопытки, ОтветПопытки.ВидСбоя);
		КонецЕсли;

	КонецЦикла;

	// <processing> Формирование итоговой диагностики
	Реакция = ЗагрузкаКурсовВалютЦБКлиентСервер.РеакцияНаСбой(Результат.ВидСбоя);

	Результат.ОписаниеОшибки = СтрШаблон(
		НСтр("ru = 'Данные от сервиса не получены. Вид сбоя: %1. %2'"),
		Результат.ВидСбоя,
		?(Реакция.Временный,
			НСтр("ru = 'Проблема оценивается как временная.'"),
			НСтр("ru = 'Проблема оценивается как постоянная: сама не пройдет.'")));
	// </processing>

	// <log> Итоговая ошибка получения данных - not delete
	ЗаписатьВЖурнал(
		УровеньЖурналаРегистрации.Ошибка,
		СтрШаблон(
			НСтр("ru = 'Загрузка курсов валют не выполнена: данные от сервиса не получены.
				|
				|Вид сбоя: %1
				|Характер: %2
				|Выполнено попыток: %3 из %4
				|Адрес: %5
				|Код состояния: %6
				|
				|Последняя ошибка:
				|%7
				|
				|Что делать:
				|%8'"),
			Результат.ВидСбоя,
			?(Реакция.Временный,
				НСтр("ru = 'временная проблема, ожидается самостоятельное восстановление'"),
				НСтр("ru = 'постоянная проблема, требуется вмешательство'")),
			Результат.ВыполненоПопыток,
			Параметры.КоличествоПопыток,
			БезопасныйАдресДляЖурнала(Параметры),
			?(Результат.КодСостояния = 0,
				НСтр("ru = 'соединение не установлено'"),
				Формат(Результат.КодСостояния, "ЧГ=0")),
			ПоследняяОшибка,
			Реакция.Рекомендация));
	// </log>

	Возврат Результат;

КонецФункции

// Разбирает XML-ответ сервиса ЦБ РФ в таблицу значений.
// Формат ответа считается недоверенным: проверяется корень документа,
// наличие и заполненность каждого поля, корректность чисел.
//
// Параметры:
//  Знач СодержимоеОтвета - ДвоичныеДанные, Строка - тело ответа сервиса.
//
// Возвращаемое значение:
//  Структура - результат разбора:
//   * Успешно        - Булево - Истина, если документ разобран и содержит хотя бы одну валюту.
//   * ДатаКурса      - Дата   - дата курсов из атрибута Date корневого элемента.
//   * Курсы          - ТаблицаЗначений - разобранные курсы:
//      ** КодВалюты  - Строка - буквенный код (CharCode), например "USD".
//      ** ЦифровойКод - Строка - цифровой код (NumCode), например "840".
//      ** Наименование - Строка - наименование валюты.
//      ** Курс       - Число  - значение курса за Кратность единиц валюты.
//      ** Кратность  - Число  - номинал (Nominal), число единиц валюты.
//   * Пропущено      - Число  - количество элементов, отброшенных при разборе.
//   * ОписаниеОшибки - Строка - текст ошибки, если Успешно = Ложь.
//
// Пример:
//  ДанныеРазбора = ЗагрузкаКурсовВалютЦБ.РазобратьОтветСервиса(Ответ.Содержимое);
//
Функция РазобратьОтветСервиса(Знач СодержимоеОтвета) Экспорт

	Результат = Новый Структура;
	ВидыСбоев = ЗагрузкаКурсовВалютЦБКлиентСервер.ВидыСбоев();

	Результат.Вставить("Успешно",        Ложь);
	Результат.Вставить("ДатаКурса",      '00010101');
	Результат.Вставить("Курсы",          НоваяТаблицаКурсов());
	Результат.Вставить("Пропущено",      0);
	Результат.Вставить("ВсегоЭлементов", 0);
	Результат.Вставить("ОписаниеОшибки", "");
	Результат.Вставить("ВидСбоя",        ВидыСбоев.НеверныйФормат);

	// <validation> Проверка непустого ответа до обращения к его полям - not delete
	Если СодержимоеОтвета = Неопределено Тогда
		Результат.ВидСбоя = ВидыСбоев.ПустойОтвет;
		Результат.ОписаниеОшибки = НСтр("ru = 'Сервис вернул пустой ответ.'");
		ЗафиксироватьОшибкуРазбора(Результат.ВидСбоя, Результат.ОписаниеОшибки);
		Возврат Результат;
	КонецЕсли;

	ТекстXML = ТекстОтветаВЮникоде(СодержимоеОтвета);
	Если ПустаяСтрока(ТекстXML) Тогда
		Результат.ВидСбоя = ВидыСбоев.ПустойОтвет;
		Результат.ОписаниеОшибки = НСтр("ru = 'Тело ответа сервиса пустое либо не читается.'");
		ЗафиксироватьОшибкуРазбора(Результат.ВидСбоя, Результат.ОписаниеОшибки);
		Возврат Результат;
	КонецЕсли;
	// </validation>

	// <error> Разбор XML в защищенном блоке: некорректный документ не роняет задание - not delete
	Попытка
		ДокументDOM = ДокументDOMИзТекста(ТекстXML);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Результат.ВидСбоя = ВидыСбоев.НеверныйФормат;
		Результат.ОписаниеОшибки = СтрШаблон(
			НСтр("ru = 'Ответ сервиса не является корректным XML: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке));

		// Фрагмент начала ответа резко ускоряет разбор инцидента: по нему сразу
		// видно, пришла ли HTML-страница авторизации прокси вместо данных.
		ЗафиксироватьОшибкуРазбора(
			Результат.ВидСбоя,
			СтрШаблон(НСтр("ru = '%1
				|
				|Начало полученного ответа:
				|%2'"),
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке),
				ФрагментОтветаДляЖурнала(ТекстXML)));
		Возврат Результат;
	КонецПопытки;
	// </error>

	// <validation> Проверка ожидаемой структуры документа - not delete
	// Свойство ДокументDOM называется ЭлементДокумента (не ПервыйДочерний):
	// первым дочерним узлом может оказаться комментарий или инструкция обработки,
	// а не корневой элемент.
	КорневойЭлемент = ДокументDOM.ЭлементДокумента;
	Если КорневойЭлемент = Неопределено Тогда
		Результат.ВидСбоя = ВидыСбоев.НеверныйФормат;
		Результат.ОписаниеОшибки = НСтр("ru = 'В ответе сервиса отсутствует корневой элемент XML.'");
		ЗафиксироватьОшибкуРазбора(Результат.ВидСбоя, Результат.ОписаниеОшибки);
		Возврат Результат;
	КонецЕсли;

	Если КорневойЭлемент.ИмяУзла <> "ValCurs" Тогда
		// Документ корректен как XML, но это не данные сервиса. Классика -
		// редирект на страницу авторизации прокси, отдавшую валидный XHTML.
		Результат.ВидСбоя = ВидыСбоев.НеверныйФормат;
		Результат.ОписаниеОшибки = СтрШаблон(
			НСтр("ru = 'Неожиданная структура ответа: корневой элемент ""%1"" вместо ""ValCurs"".%2'"),
			КорневойЭлемент.ИмяУзла,
			?(ВРег(КорневойЭлемент.ИмяУзла) = "HTML",
				НСтр("ru = ' Получена HTML-страница вместо данных сервиса.'"),
				""));

		ЗафиксироватьОшибкуРазбора(
			Результат.ВидСбоя,
			СтрШаблон(НСтр("ru = '%1
				|
				|Начало полученного ответа:
				|%2'"),
				Результат.ОписаниеОшибки,
				ФрагментОтветаДляЖурнала(ТекстXML)));
		Возврат Результат;
	КонецЕсли;
	// </validation>

	// Атрибут Date может отсутствовать - тогда используем текущую дату сеанса.
	Результат.ДатаКурса = ЗагрузкаКурсовВалютЦБКлиентСервер.ДатаИзСтрокиВнешнегоФормата(
		ЗначениеАтрибута(КорневойЭлемент, "Date"));

	Если Результат.ДатаКурса = Неопределено Тогда
		Результат.ДатаКурса = НачалоДня(ТекущаяДатаСеанса());
		ЗаписатьВЖурнал(
			УровеньЖурналаРегистрации.Предупреждение,
			СтрШаблон(НСтр("ru = 'В ответе сервиса не указана корректная дата курсов.
				|Используется текущая дата сеанса: %1
				|Возможно изменение формата ответа сервиса - требуется проверка.'"),
				Формат(Результат.ДатаКурса, "ДФ=dd.MM.yyyy")));
	КонецЕсли;

	// <processing> Обход элементов Valute
	ЭлементыВалют = КорневойЭлемент.ПолучитьЭлементыПоИмени("Valute");
	Результат.ВсегоЭлементов = ЭлементыВалют.Количество();

	Если Результат.ВсегоЭлементов = 0 Тогда
		Результат.ВидСбоя = ВидыСбоев.НеверныйФормат;
		Результат.ОписаниеОшибки = НСтр("ru = 'Структура ответа верна, но в нем нет ни одного элемента Valute.'");
		ЗафиксироватьОшибкуРазбора(Результат.ВидСбоя, Результат.ОписаниеОшибки);
		Возврат Результат;
	КонецЕсли;

	ОписанияПропусков = Новый Массив;

	Для Каждого ЭлементВалюты Из ЭлементыВалют Цикл

		ПричинаПропуска = "";
		СтрокаКурса = РазобратьЭлементВалюты(ЭлементВалюты, ПричинаПропуска);

		Если СтрокаКурса = Неопределено Тогда
			Результат.Пропущено = Результат.Пропущено + 1;
			Если ОписанияПропусков.Количество() < 50 Тогда
				// Ограничиваем объем: полный список при массовом сбое формата
				// раздует запись журнала регистрации.
				ОписанияПропусков.Добавить(ПричинаПропуска);
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Результат.Курсы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКурса);

	КонецЦикла;
	// </processing>

	// <validation> Ни один элемент не разобран - формат ответа изменился - not delete
	Если Результат.Курсы.Количество() = 0 Тогда
		Результат.ВидСбоя = ВидыСбоев.НеверныйФормат;
		Результат.ОписаниеОшибки = СтрШаблон(
			НСтр("ru = 'Получено %1 элементов, но ни один не удалось разобрать.
				|Вероятно, изменился формат ответа сервиса.'"),
			Результат.ВсегоЭлементов);

		ЗафиксироватьОшибкуРазбора(
			Результат.ВидСбоя,
			СтрШаблон(НСтр("ru = '%1
				|
				|Причины отбраковки:
				|%2'"),
				Результат.ОписаниеОшибки,
				СтрСоединить(ОписанияПропусков, Символы.ПС)));
		Возврат Результат;
	КонецЕсли;
	// </validation>

	// <log> Отбракованные элементы фиксируются, чтобы расхождения не были тихими - not delete
	Если ОписанияПропусков.Количество() > 0 Тогда

		ДоляПропусков = Результат.Пропущено / Результат.ВсегоЭлементов;
		ДопустимаяДоля = ПараметрыПодключения().ДопустимаяДоляПропусков;

		// Единичная отбраковка - штатная ситуация (сервис не публикует курс валюты).
		// Массовая - признак изменения формата, это уже инцидент.
		Если ДоляПропусков > ДопустимаяДоля Тогда
			Уровень = УровеньЖурналаРегистрации.Ошибка;
			Оценка = НСтр("ru = 'Доля отбракованных элементов превышает допустимую -
				|вероятно изменение формата ответа сервиса. Требуется проверка.'");
		Иначе
			Уровень = УровеньЖурналаРегистрации.Предупреждение;
			Оценка = НСтр("ru = 'Доля отбраковки в пределах нормы,
				|вмешательство не требуется.'");
		КонецЕсли;

		ЗаписатьВЖурнал(
			Уровень,
			СтрШаблон(НСтр("ru = 'При разборе ответа отбраковано элементов: %1 из %2 (%3%).
				|%4
				|
				|Причины:
				|%5'"),
				Результат.Пропущено,
				Результат.ВсегоЭлементов,
				Формат(ДоляПропусков * 100, "ЧДЦ=1; ЧГ=0"),
				Оценка,
				СтрСоединить(ОписанияПропусков, Символы.ПС)));
	КонецЕсли;
	// </log>

	Результат.ВидСбоя = ?(Результат.Пропущено > 0, ВидыСбоев.НеполныеДанные, ВидыСбоев.Нет);
	Результат.Успешно = Истина;

	Возврат Результат;

КонецФункции

// Записывает разобранные курсы в регистр сведений КурсыВалют.
// Запись выполняется наборами записей по измерению Валюта на дату курса.
// Валюты, не найденные в справочнике Валюты, пропускаются с записью в журнал.
//
// Параметры:
//  Знач ТаблицаКурсов - ТаблицаЗначений - результат РазобратьОтветСервиса().Курсы.
//  Знач ПараметрыЗаписи - Структура - параметры записи:
//   * ДатаКурса               - Дата   - период записи в регистр.
//   * ТолькоЗагружаемыеВалюты - Булево - записывать только валюты с признаком
//                                        ЗагружаетсяИзИнтернета.
//
// Возвращаемое значение:
//  Структура - результат записи:
//   * Успешно        - Булево - Истина, если запись выполнена без критических ошибок.
//   * Записано       - Число  - количество записанных наборов.
//   * Пропущено      - Число  - количество пропущенных строк.
//   * ОписаниеОшибки - Строка - текст ошибки, если Успешно = Ложь.
//
// Пример:
//  РезультатЗаписи = ЗагрузкаКурсовВалютЦБ.ЗаписатьКурсыВРегистр(Курсы, ПараметрыЗаписи);
//
Функция ЗаписатьКурсыВРегистр(Знач ТаблицаКурсов, Знач ПараметрыЗаписи) Экспорт

	ВидыСбоев = ЗагрузкаКурсовВалютЦБКлиентСервер.ВидыСбоев();

	Результат = Новый Структура;
	Результат.Вставить("Успешно",        Ложь);
	Результат.Вставить("Записано",       0);
	Результат.Вставить("Пропущено",      0);
	Результат.Вставить("НеЗаписано",     0);
	Результат.Вставить("ОписаниеОшибки", "");
	Результат.Вставить("ВидСбоя",        ВидыСбоев.Нет);

	// <validation> Проверка входных данных до обращения к базе - not delete
	Если ТипЗнч(ТаблицаКурсов) <> Тип("ТаблицаЗначений") Или ТаблицаКурсов.Количество() = 0 Тогда
		Результат.ВидСбоя = ВидыСбоев.НеполныеДанные;
		Результат.ОписаниеОшибки = НСтр("ru = 'Нет данных для записи в регистр курсов валют.'");
		Возврат Результат;
	КонецЕсли;

	ДатаКурса = НачалоДня(ПараметрыЗаписи.ДатаКурса);
	Если НЕ ЗначениеЗаполнено(ДатаКурса) Тогда
		Результат.ВидСбоя = ВидыСбоев.ВнутренняяОшибка;
		Результат.ОписаниеОшибки = НСтр("ru = 'Не определена дата курсов для записи в регистр.'");
		Возврат Результат;
	КонецЕсли;
	// </validation>

	// <query> Сопоставление кодов валют со справочником Валюты
	СоответствиеВалют = ВалютыПоКодам(
		ТаблицаКурсов.ВыгрузитьКолонку("КодВалюты"),
		ПараметрыЗаписи.ТолькоЗагружаемыеВалюты);
	// </query>

	ОписанияПропусков = Новый Массив;

	Для Каждого СтрокаКурса Из ТаблицаКурсов Цикл

		Валюта = СоответствиеВалют.Получить(ВРег(СтрокаКурса.КодВалюты));

		Если Валюта = Неопределено Тогда
			// Валюта не заведена в справочнике либо не отмечена для загрузки -
			// это штатная ситуация, а не ошибка.
			Результат.Пропущено = Результат.Пропущено + 1;
			Продолжить;
		КонецЕсли;

		// <error> Ошибка записи одной валюты не должна прерывать загрузку остальных - not delete
		// Транзакция на весь пакет намеренно не открывается: для курсов частичная
		// загрузка полезнее, чем откат всех валют из-за одной проблемной.
		ОшибкаЗаписи = "";
		Если ЗаписатьКурсСПовторами(Валюта, ДатаКурса, СтрокаКурса, ОшибкаЗаписи) Тогда
			Результат.Записано = Результат.Записано + 1;
		Иначе
			Результат.НеЗаписано = Результат.НеЗаписано + 1;
			ОписанияПропусков.Добавить(СтрШаблон(
				НСтр("ru = 'Валюта %1 (%2): %3'"),
				СтрокаКурса.КодВалюты,
				Строка(Валюта),
				ОшибкаЗаписи));
		КонецЕсли;
		// </error>

	КонецЦикла;

	// <validation> Оценка итога записи - not delete
	Если Результат.Записано = 0 Тогда
		// Ничего не записано. Разделяем две принципиально разные причины:
		// нечего было записывать или база не приняла корректные данные.
		Если Результат.НеЗаписано > 0 Тогда
			Результат.ВидСбоя = ВидыСбоев.ОшибкаЗаписи;
			Результат.ОписаниеОшибки = СтрШаблон(
				НСтр("ru = 'Данные получены корректно, но ни один курс не записан в базу.
					|Не записано из-за ошибок: %1.'"),
				Результат.НеЗаписано);
		Иначе
			Результат.ВидСбоя = ВидыСбоев.НеполныеДанные;
			Результат.ОписаниеОшибки = СтрШаблон(
				НСтр("ru = 'Не записано ни одного курса: ни одна из %1 валют ответа
					|не сопоставлена со справочником Валюты.'"),
				Результат.Пропущено);
		КонецЕсли;

		Реакция = ЗагрузкаКурсовВалютЦБКлиентСервер.РеакцияНаСбой(Результат.ВидСбоя);

		// <log> Нулевой результат записи - это всегда инцидент - not delete
		ЗаписатьВЖурнал(
			УровеньЖурналаРегистрации.Ошибка,
			СтрШаблон(НСтр("ru = 'Загрузка курсов валют не выполнена: данные не записаны в базу.
				|
				|Вид сбоя: %1
				|Дата курсов: %2
				|Не сопоставлено со справочником: %3
				|Не записано из-за ошибок: %4
				|
				|Причины:
				|%5
				|
				|Что делать:
				|%6'"),
				Результат.ВидСбоя,
				Формат(ДатаКурса, "ДФ=dd.MM.yyyy"),
				Результат.Пропущено,
				Результат.НеЗаписано,
				?(ОписанияПропусков.Количество() = 0,
					НСтр("ru = 'нет валют с признаком ЗагружаетсяИзИнтернета либо коды не совпадают'"),
					СтрСоединить(ОписанияПропусков, Символы.ПС)),
				Реакция.Рекомендация));
		// </log>

		Возврат Результат;
	КонецЕсли;

	// Часть валют не записалась, но остальные записаны: результат считаем
	// успешным (курсы в базе актуальны), однако сбой фиксируем для разбора.
	Если Результат.НеЗаписано > 0 Тогда
		Результат.ВидСбоя = ВидыСбоев.ОшибкаЗаписи;
		Результат.ОписаниеОшибки = СтрШаблон(
			НСтр("ru = 'Записано %1 курсов, не записано из-за ошибок: %2.'"),
			Результат.Записано,
			Результат.НеЗаписано);

		ЗаписатьВЖурнал(
			УровеньЖурналаРегистрации.Ошибка,
			СтрШаблон(НСтр("ru = 'Курсы валют записаны частично.
				|
				|Дата курсов: %1
				|Записано: %2
				|Не записано из-за ошибок: %3
				|
				|Причины:
				|%4
				|
				|Что делать:
				|%5'"),
				Формат(ДатаКурса, "ДФ=dd.MM.yyyy"),
				Результат.Записано,
				Результат.НеЗаписано,
				СтрСоединить(ОписанияПропусков, Символы.ПС),
				ЗагрузкаКурсовВалютЦБКлиентСервер.РеакцияНаСбой(ВидыСбоев.ОшибкаЗаписи).Рекомендация));
	КонецЕсли;
	// </validation>

	Результат.Успешно = Истина;

	Возврат Результат;

КонецФункции

// Возвращает параметры подключения к сервису с учетом значений констант.
// Константы необязательны: если они не созданы или не заполнены,
// используются значения по умолчанию.
//
// Возвращаемое значение:
//  Структура - см. ЗагрузкаКурсовВалютЦБКлиентСервер.ПараметрыПодключенияПоУмолчанию.
//
// Пример:
//  Параметры = ЗагрузкаКурсовВалютЦБ.ПараметрыПодключения();
//
Функция ПараметрыПодключения() Экспорт

	Параметры = ЗагрузкаКурсовВалютЦБКлиентСервер.ПараметрыПодключенияПоУмолчанию();

	// <error> Отсутствие необязательных констант не должно ломать загрузку - not delete
	Попытка
		Если Метаданные.Константы.Найти("ТаймаутЗагрузкиКурсовВалют") <> Неопределено Тогда
			ЗначениеКонстанты = Константы.ТаймаутЗагрузкиКурсовВалют.Получить();
			Если ЗначениеКонстанты > 0 Тогда
				Параметры.Таймаут = ЗначениеКонстанты;
			КонецЕсли;
		КонецЕсли;

		Если Метаданные.Константы.Найти("КоличествоПопытокЗагрузкиКурсовВалют") <> Неопределено Тогда
			ЗначениеКонстанты = Константы.КоличествоПопытокЗагрузкиКурсовВалют.Получить();
			Если ЗначениеКонстанты > 0 Тогда
				Параметры.КоличествоПопыток = ЗначениеКонстанты;
			КонецЕсли;
		КонецЕсли;
	Исключение
		// Права на чтение констант или сами константы могут отсутствовать.
		// Работаем на значениях по умолчанию, но факт фиксируем.
		ЗаписьЖурналаРегистрации(
			ЗагрузкаКурсовВалютЦБКлиентСервер.ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			СтрШаблон(НСтр("ru = 'Не удалось прочитать настройки загрузки курсов, применяются значения по умолчанию.
				|%1'"),
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	// </error>

	Возврат Параметры;

КонецФункции

// Служебная процедура-заглушка для организации паузы на сервере.
// Запускается как фоновое задание, работы не выполняет: ожидание обеспечивает
// вызывающий код методом ОжидатьЗавершенияВыполнения.
// Вызывать из прикладного кода не следует.
//
// Параметры:
//  Знач Секунд - Число - время ожидания, секунд. Параметр не используется,
//                        объявлен для совместимости с сигнатурой запуска задания.
//
Процедура ОжиданиеФоновогоЗадания(Знач Секунд = 0) Экспорт

	// Тело намеренно пустое: задание нужно только как объект ожидания.
	Возврат;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполняет один HTTP-запрос к сервису.
// Исключения не перехватываются: их обрабатывает вызывающий цикл попыток.
//
// Параметры:
//  Знач Параметры - Структура - см. ПараметрыПодключения().
//
// Возвращаемое значение:
//  Структура - результат одной попытки: Успешно, Содержимое, КодСостояния,
//              ОписаниеОшибки, ВидСбоя.
//
Функция ВыполнитьЗапросКСервису(Знач Параметры)

	ВидыСбоев = ЗагрузкаКурсовВалютЦБКлиентСервер.ВидыСбоев();

	Ответ = Новый Структура;
	Ответ.Вставить("Успешно",        Ложь);
	Ответ.Вставить("Содержимое",     Неопределено);
	Ответ.Вставить("КодСостояния",   0);
	Ответ.Вставить("ОписаниеОшибки", "");
	Ответ.Вставить("ВидСбоя",        ВидыСбоев.Сеть);

	ЗащищенноеСоединение = Неопределено;
	Если Параметры.ЗащищенноеСоединение Тогда
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
	КонецЕсли;

	// Таймаут задается явно: без него ожидание ответа не ограничено,
	// и зависший сервис заблокирует регламентное задание до перезапуска.
	Соединение = Новый HTTPСоединение(
		Параметры.Сервер,
		,                       // порт по умолчанию для схемы
		,                       // пользователь - аутентификация не требуется
		,                       // пароль
		,                       // прокси - берется из настроек ИБ
		Параметры.Таймаут,
		ЗащищенноеСоединение);

	Запрос = Новый HTTPЗапрос(Параметры.АдресРесурса);
	Запрос.Заголовки.Вставить("Accept", "text/xml, application/xml");

	HTTPОтвет = Соединение.Получить(Запрос);

	// <validation> Код состояния проверяется ДО обращения к телу ответа - not delete
	Ответ.КодСостояния = HTTPОтвет.КодСостояния;

	Если Ответ.КодСостояния <> 200 Тогда
		Ответ.ВидСбоя = ЗагрузкаКурсовВалютЦБКлиентСервер.ВидСбояПоКодуСостояния(Ответ.КодСостояния);
		Ответ.ОписаниеОшибки = СтрШаблон(
			НСтр("ru = 'Сервис вернул код состояния %1 (%2).'"),
			Ответ.КодСостояния,
			РасшифровкаКодаСостояния(Ответ.КодСостояния));
		Возврат Ответ;
	КонецЕсли;
	// </validation>

	ТелоОтвета = HTTPОтвет.ПолучитьТелоКакДвоичныеДанные();

	// <validation> Пустое тело при коде 200 - тоже ошибка - not delete
	Если ТелоОтвета = Неопределено Или ТелоОтвета.Размер() = 0 Тогда
		Ответ.ВидСбоя = ВидыСбоев.ПустойОтвет;
		Ответ.ОписаниеОшибки = НСтр("ru = 'Сервис вернул код 200, но тело ответа пустое.'");
		Возврат Ответ;
	КонецЕсли;
	// </validation>

	Ответ.Успешно    = Истина;
	Ответ.ВидСбоя    = ВидыСбоев.Нет;
	Ответ.Содержимое = ТелоОтвета;

	Возврат Ответ;

КонецФункции

// Возвращает краткую расшифровку кода состояния HTTP на русском языке.
// Нужна, чтобы дежурный понимал смысл кода без обращения к справочникам.
//
// Параметры:
//  Знач КодСостояния - Число - код состояния HTTP.
//
// Возвращаемое значение:
//  Строка - расшифровка кода.
//
Функция РасшифровкаКодаСостояния(Знач КодСостояния)

	Если КодСостояния = 400 Тогда
		Возврат НСтр("ru = 'некорректный запрос'");
	ИначеЕсли КодСостояния = 401 Тогда
		Возврат НСтр("ru = 'требуется аутентификация'");
	ИначеЕсли КодСостояния = 403 Тогда
		Возврат НСтр("ru = 'доступ запрещен'");
	ИначеЕсли КодСостояния = 404 Тогда
		Возврат НСтр("ru = 'ресурс не найден'");
	ИначеЕсли КодСостояния = 408 Тогда
		Возврат НСтр("ru = 'таймаут запроса'");
	ИначеЕсли КодСостояния = 429 Тогда
		Возврат НСтр("ru = 'превышено допустимое число обращений'");
	ИначеЕсли КодСостояния = 500 Тогда
		Возврат НСтр("ru = 'внутренняя ошибка сервиса'");
	ИначеЕсли КодСостояния = 502 Тогда
		Возврат НСтр("ru = 'ошибка шлюза'");
	ИначеЕсли КодСостояния = 503 Тогда
		Возврат НСтр("ru = 'сервис временно недоступен'");
	ИначеЕсли КодСостояния = 504 Тогда
		Возврат НСтр("ru = 'таймаут шлюза'");
	ИначеЕсли КодСостояния >= 300 И КодСостояния < 400 Тогда
		Возврат НСтр("ru = 'перенаправление'");
	ИначеЕсли КодСостояния >= 400 И КодСостояния < 500 Тогда
		Возврат НСтр("ru = 'ошибка запроса'");
	ИначеЕсли КодСостояния >= 500 Тогда
		Возврат НСтр("ru = 'ошибка сервиса'");
	КонецЕсли;

	Возврат НСтр("ru = 'нестандартный код'");

КонецФункции

// Выдерживает паузу перед повторной попыткой.
// Пауза растет с номером попытки и содержит случайную добавку (джиттер).
//
// Параметры:
//  Знач Параметры    - Структура - см. ПараметрыПодключения().
//  Знач НомерПопытки - Число     - номер завершившейся попытки, начиная с 1.
//  Знач ВидСбоя      - Строка    - вид сбоя, см. ЗагрузкаКурсовВалютЦБКлиентСервер.ВидыСбоев().
//
Процедура ВыполнитьПаузуПередПовтором(Знач Параметры, Знач НомерПопытки, Знач ВидСбоя)

	ВидыСбоев = ЗагрузкаКурсовВалютЦБКлиентСервер.ВидыСбоев();

	// Базовый рост линейный: 5, 10, 15 с. Экспоненциальный при 3 попытках
	// избыточен, а суммарное время работы задания важно держать предсказуемым.
	Задержка = Параметры.ПаузаМеждуПопытками * НомерПопытки;

	Если ВидСбоя = ВидыСбоев.ПревышенЛимит Тогда
		// Сервис прямо сообщил, что обращений слишком много - отступаем заметно дальше.
		Задержка = Задержка * 2;
	КонецЕсли;

	// <error> Джиттер не критичен: при сбое генератора используем базовую паузу - not delete
	Попытка
		Генератор = Новый ГенераторСлучайныхЧисел;
		// Случайная добавка до заданной доли от задержки. Без нее несколько баз,
		// стартующих по одному расписанию, повторяют запросы синхронно и
		// усиливают нагрузку на сервис, который уже отвечает ошибкой.
		МаксимальнаяДобавка = Задержка * Параметры.ДоляСлучайнойДобавки;
		Если МаксимальнаяДобавка >= 1 Тогда
			Задержка = Задержка + Генератор.СлучайноеЧисло(0, Цел(МаксимальнаяДобавка));
		КонецЕсли;
	Исключение
		// Работаем без джиттера - на корректность это не влияет.
		ЗаписатьВЖурнал(
			УровеньЖурналаРегистрации.Информация,
			СтрШаблон(НСтр("ru = 'Не удалось вычислить случайную добавку к паузе,
				|используется базовая пауза %1 с.
				|%2'"),
				Задержка,
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	// </error>

	// <error> Сбой самой паузы не должен прерывать загрузку - not delete
	Попытка
		Пауза(Задержка);
	Исключение
		// Пауза реализована через ожидание фонового задания и в некоторых
		// контекстах (например, внешнее соединение) может быть недоступна.
		// Повтор выполняем без паузы - это хуже, но лучше отказа от загрузки.
		ЗаписатьВЖурнал(
			УровеньЖурналаРегистрации.Предупреждение,
			СтрШаблон(НСтр("ru = 'Не удалось выдержать паузу %1 с перед повтором,
				|повторная попытка выполняется без задержки.
				|%2'"),
				Задержка,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	// </error>

КонецПроцедуры

// Приостанавливает выполнение на заданное время.
// Реализация повторяет штатный подход БСП: ПриостановитьВыполнение() - метод
// клиентского контекста и на сервере недоступен, поэтому ожидание выполняется
// через фоновое задание.
//
// Параметры:
//  Знач Секунд - Число - время ожидания, секунд.
//
Процедура Пауза(Знач Секунд)

	Если Секунд <= 0 Тогда
		Возврат;
	КонецЕсли;

	ТекущийСеансИнформационнойБазы = ПолучитьТекущийСеансИнформационнойБазы();
	ФоновоеЗадание = ТекущийСеансИнформационнойБазы.ПолучитьФоновоеЗадание();

	Если ФоновоеЗадание = Неопределено Тогда
		// Код выполняется не в фоновом задании (например, из внешней обработки).
		// Запускаем пустое фоновое задание и ждем его завершения.
		ПараметрыЗадания = Новый Массив;
		ПараметрыЗадания.Добавить(Секунд);
		ФоновоеЗадание = ФоновыеЗадания.Выполнить("ЗагрузкаКурсовВалютЦБ.ОжиданиеФоновогоЗадания",
			ПараметрыЗадания);
	КонецЕсли;

	ФоновоеЗадание.ОжидатьЗавершенияВыполнения(Секунд);

КонецПроцедуры

// Записывает сообщение в журнал регистрации под единым событием механизма.
//
// Параметры:
//  Знач Уровень      - УровеньЖурналаРегистрации - уровень записи.
//  Знач Текст        - Строка - текст сообщения.
//  Знач ДанныеОбъекта - ЛюбаяСсылка, Неопределено - объект для колонки "Данные".
//
Процедура ЗаписатьВЖурнал(Знач Уровень, Знач Текст, Знач ДанныеОбъекта = Неопределено)

	// Метаданные регистра указываются всегда: по ним удобно отбирать записи
	// механизма в журнале регистрации.
	ЗаписьЖурналаРегистрации(
		ЗагрузкаКурсовВалютЦБКлиентСервер.ИмяСобытияЖурнала(),
		Уровень,
		Метаданные.РегистрыСведений.КурсыВалют,
		ДанныеОбъекта,
		Текст);

КонецПроцедуры

// Преобразует тело ответа в строку с учетом объявленной кодировки.
// Сервис ЦБ РФ отдает XML в windows-1251, поэтому чтение в UTF-8 испортит
// кириллические наименования валют.
//
// Параметры:
//  Знач СодержимоеОтвета - ДвоичныеДанные, Строка - тело ответа.
//
// Возвращаемое значение:
//  Строка - текст XML в юникоде с приведенным объявлением кодировки.
//
Функция ТекстОтветаВЮникоде(Знач СодержимоеОтвета)

	Если ТипЗнч(СодержимоеОтвета) = Тип("Строка") Тогда
		// Строка уже в юникоде: остается снять объявление кодировки,
		// иначе построитель DOM попытается применить его повторно.
		Возврат ЗаменитьОбъявлениеКодировки(СодержимоеОтвета);
	КонецЕсли;

	Если ТипЗнч(СодержимоеОтвета) <> Тип("ДвоичныеДанные") Тогда
		Возврат "";
	КонецЕсли;

	// Кодировку определяем по XML-декларации, а не по заголовку Content-Type:
	// сервис объявляет ее именно в теле документа.
	Кодировка = КодировкаИзОбъявленияXML(СодержимоеОтвета);

	// <error> Чтение с объявленной кодировкой, при неудаче - откат на windows-1251 - not delete
	Попытка
		Чтение = Новый ЧтениеТекста(СодержимоеОтвета.ОткрытьПотокДляЧтения(), Кодировка);
		ТекстXML = Чтение.Прочитать();
		Чтение.Закрыть();
	Исключение
		ЗаписьЖурналаРегистрации(
			ЗагрузкаКурсовВалютЦБКлиентСервер.ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			СтрШаблон(НСтр("ru = 'Не удалось прочитать ответ в кодировке ""%1"", применяется windows-1251.
				|%2'"),
				Кодировка,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));

		Попытка
			Чтение = Новый ЧтениеТекста(СодержимоеОтвета.ОткрытьПотокДляЧтения(), "windows-1251");
			ТекстXML = Чтение.Прочитать();
			Чтение.Закрыть();
		Исключение
			ЗаписьЖурналаРегистрации(
				ЗагрузкаКурсовВалютЦБКлиентСервер.ИмяСобытияЖурнала(),
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				СтрШаблон(НСтр("ru = 'Не удалось прочитать тело ответа сервиса.
					|%1'"),
					ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
			Возврат "";
		КонецПопытки;
	КонецПопытки;
	// </error>

	Если ТекстXML = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	// После перекодирования в юникод объявление windows-1251 в декларации
	// стало недостоверным - убираем его, иначе разбор DOM завершится ошибкой.
	Возврат ЗаменитьОбъявлениеКодировки(ТекстXML);

КонецФункции

// Определяет кодировку по XML-декларации в начале документа.
//
// Параметры:
//  Знач Данные - ДвоичныеДанные - тело ответа.
//
// Возвращаемое значение:
//  Строка - имя кодировки. Если декларация не найдена, возвращается "windows-1251"
//           как объявленная кодировка сервиса ЦБ РФ.
//
Функция КодировкаИзОбъявленияXML(Знач Данные)

	КодировкаПоУмолчанию = "windows-1251";

	// <error> Определение кодировки не должно ронять разбор - not delete
	Попытка
		// Декларация записана символами ASCII, поэтому первые байты безопасно
		// прочитать как однобайтовую кодировку независимо от реальной.
		Чтение = Новый ЧтениеТекста(Данные.ОткрытьПотокДляЧтения(), "windows-1251");
		Начало = Чтение.Прочитать(200);
		Чтение.Закрыть();
	Исключение
		ЗаписьЖурналаРегистрации(
			ЗагрузкаКурсовВалютЦБКлиентСервер.ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			СтрШаблон(НСтр("ru = 'Не удалось определить кодировку ответа, применяется %1.
				|%2'"),
				КодировкаПоУмолчанию,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат КодировкаПоУмолчанию;
	КонецПопытки;
	// </error>

	Если Начало = Неопределено Тогда
		Возврат КодировкаПоУмолчанию;
	КонецЕсли;

	ПозицияКлюча = СтрНайти(НРег(Начало), "encoding=");
	Если ПозицияКлюча = 0 Тогда
		Возврат КодировкаПоУмолчанию;
	КонецЕсли;

	Остаток = Сред(Начало, ПозицияКлюча + СтрДлина("encoding="));
	Остаток = СокрЛ(Остаток);
	Если ПустаяСтрока(Остаток) Тогда
		Возврат КодировкаПоУмолчанию;
	КонецЕсли;

	Кавычка = Лев(Остаток, 1);
	Если Кавычка <> """" И Кавычка <> "'" Тогда
		Возврат КодировкаПоУмолчанию;
	КонецЕсли;

	Остаток = Сред(Остаток, 2);
	ПозицияЗакрытия = СтрНайти(Остаток, Кавычка);
	Если ПозицияЗакрытия <= 1 Тогда
		Возврат КодировкаПоУмолчанию;
	КонецЕсли;

	Возврат СокрЛП(Лев(Остаток, ПозицияЗакрытия - 1));

КонецФункции

// Удаляет атрибут encoding из XML-декларации.
// Требуется, так как текст уже находится в юникоде, а объявленная
// в документе однобайтовая кодировка привела бы к ошибке разбора.
//
// Параметры:
//  Знач ТекстXML - Строка - текст документа.
//
// Возвращаемое значение:
//  Строка - текст без объявления кодировки.
//
Функция ЗаменитьОбъявлениеКодировки(Знач ТекстXML)

	Если Не СтрНачинаетсяС(СокрЛ(ТекстXML), "<?xml") Тогда
		Возврат ТекстXML;
	КонецЕсли;

	ПозицияКонцаДекларации = СтрНайти(ТекстXML, "?>");
	Если ПозицияКонцаДекларации = 0 Тогда
		Возврат ТекстXML;
	КонецЕсли;

	Возврат Сред(ТекстXML, ПозицияКонцаДекларации + 2);

КонецФункции

// Строит DOM-документ из текста XML.
//
// Параметры:
//  Знач ТекстXML - Строка - текст документа в юникоде.
//
// Возвращаемое значение:
//  ДокументDOM - разобранный документ.
//
Функция ДокументDOMИзТекста(Знач ТекстXML)

	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстXML);

	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
	ЧтениеXML.Закрыть();

	Возврат ДокументDOM;

КонецФункции

// Разбирает один элемент Valute в структуру курса.
//
// Параметры:
//  Знач ЭлементВалюты - ЭлементDOM - узел Valute.
//  ПричинаПропуска    - Строка     - возвращаемое описание причины, если элемент отброшен.
//
// Возвращаемое значение:
//  Структура, Неопределено - разобранный курс либо Неопределено, если элемент некорректен:
//   * КодВалюты    - Строка - буквенный код.
//   * ЦифровойКод  - Строка - цифровой код.
//   * Наименование - Строка - наименование валюты.
//   * Курс         - Число  - курс за Кратность единиц.
//   * Кратность    - Число  - номинал.
//
Функция РазобратьЭлементВалюты(Знач ЭлементВалюты, ПричинаПропуска)

	Идентификатор = ЗначениеАтрибута(ЭлементВалюты, "ID");

	// <validation> Обязательные поля проверяются до использования - not delete
	КодВалюты = ЗначениеДочернегоЭлемента(ЭлементВалюты, "CharCode");
	Если ПустаяСтрока(КодВалюты) Тогда
		ПричинаПропуска = СтрШаблон(
			НСтр("ru = 'Элемент ID=%1: не заполнен CharCode.'"),
			?(ПустаяСтрока(Идентификатор), НСтр("ru = '<не указан>'"), Идентификатор));
		Возврат Неопределено;
	КонецЕсли;

	СтрокаКурса = ЗначениеДочернегоЭлемента(ЭлементВалюты, "Value");
	Если ПустаяСтрока(СтрокаКурса) Тогда
		ПричинаПропуска = СтрШаблон(
			НСтр("ru = 'Валюта %1: не заполнено значение курса (Value).'"), КодВалюты);
		Возврат Неопределено;
	КонецЕсли;

	Курс = ЗагрузкаКурсовВалютЦБКлиентСервер.ЧислоИзСтрокиВнешнегоФормата(СтрокаКурса);
	Если Курс = Неопределено Тогда
		ПричинаПропуска = СтрШаблон(
			НСтр("ru = 'Валюта %1: значение курса ""%2"" не является числом.'"),
			КодВалюты, СтрокаКурса);
		Возврат Неопределено;
	КонецЕсли;

	Если Курс <= 0 Тогда
		// Нулевой или отрицательный курс сделает пересчет сумм некорректным.
		ПричинаПропуска = СтрШаблон(
			НСтр("ru = 'Валюта %1: недопустимое значение курса %2.'"),
			КодВалюты, Формат(Курс, "ЧДЦ=4; ЧГ=0"));
		Возврат Неопределено;
	КонецЕсли;
	// </validation>

	// <validation> Кратность (Nominal): курс относится к партии, а не к единице - not delete
	СтрокаКратности = ЗначениеДочернегоЭлемента(ЭлементВалюты, "Nominal");
	Кратность = ЗагрузкаКурсовВалютЦБКлиентСервер.ЧислоИзСтрокиВнешнегоФормата(СтрокаКратности);

	Если Кратность = Неопределено Или Кратность <= 0 Тогда
		// Игнорировать номинал нельзя: для валют вроде JPY (Nominal=100)
		// это дает ошибку пересчета в 100 раз, причем без каких-либо признаков сбоя.
		ПричинаПропуска = СтрШаблон(
			НСтр("ru = 'Валюта %1: не удалось определить кратность (Nominal = ""%2"").'"),
			КодВалюты,
			?(СтрокаКратности = Неопределено, "", СтрокаКратности));
		Возврат Неопределено;
	КонецЕсли;

	// Кратность в регистре имеет тип число(10,0) - дробный номинал недопустим.
	Если Цел(Кратность) <> Кратность Тогда
		ПричинаПропуска = СтрШаблон(
			НСтр("ru = 'Валюта %1: дробная кратность %2 не поддерживается.'"),
			КодВалюты, Формат(Кратность, "ЧДЦ=4; ЧГ=0"));
		Возврат Неопределено;
	КонецЕсли;
	// </validation>

	Результат = Новый Структура;
	Результат.Вставить("КодВалюты",    ВРег(СокрЛП(КодВалюты)));
	// Необязательные поля: их отсутствие не является причиной пропуска элемента.
	Результат.Вставить("ЦифровойКод",  ЗначениеДочернегоЭлемента(ЭлементВалюты, "NumCode"));
	Результат.Вставить("Наименование", ЗначениеДочернегоЭлемента(ЭлементВалюты, "Name"));
	Результат.Вставить("Курс",         Курс);
	Результат.Вставить("Кратность",    Кратность);

	Возврат Результат;

КонецФункции

// Возвращает текстовое значение дочернего элемента.
//
// Параметры:
//  Знач РодительскийЭлемент - ЭлементDOM - узел-родитель.
//  Знач ИмяЭлемента         - Строка     - имя искомого дочернего элемента.
//
// Возвращаемое значение:
//  Строка - значение элемента либо пустая строка, если элемент отсутствует или пуст.
//
Функция ЗначениеДочернегоЭлемента(Знач РодительскийЭлемент, Знач ИмяЭлемента)

	Если РодительскийЭлемент = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	// Обходим только непосредственных потомков. ПолучитьЭлементыПоИмени здесь
	// не используется: этот метод ищет по всем уровням вложенности, и при
	// изменении структуры ответа мог бы вернуть одноименный элемент из другой ветки.
	Для Каждого ДочернийУзел Из РодительскийЭлемент.ДочерниеУзлы Цикл

		Если ДочернийУзел.ИмяУзла <> ИмяЭлемента Тогда
			Продолжить;
		КонецЕсли;

		ТекстовоеСодержимое = ДочернийУзел.ТекстовоеСодержимое;
		Если ТекстовоеСодержимое = Неопределено Тогда
			Возврат "";
		КонецЕсли;

		Возврат СокрЛП(ТекстовоеСодержимое);

	КонецЦикла;

	// Необязательное поле может отсутствовать - это не ошибка.
	Возврат "";

КонецФункции

// Возвращает значение атрибута элемента.
//
// Параметры:
//  Знач Элемент      - ЭлементDOM - узел.
//  Знач ИмяАтрибута  - Строка     - имя атрибута.
//
// Возвращаемое значение:
//  Строка - значение атрибута либо пустая строка.
//
Функция ЗначениеАтрибута(Знач Элемент, Знач ИмяАтрибута)

	Если Элемент = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если Не Элемент.ЕстьАтрибут(ИмяАтрибута) Тогда
		Возврат "";
	КонецЕсли;

	Значение = Элемент.ПолучитьАтрибут(ИмяАтрибута);

	Возврат ?(Значение = Неопределено, "", СокрЛП(Значение));

КонецФункции

// Создает пустую таблицу разобранных курсов.
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица с колонками КодВалюты, ЦифровойКод, Наименование, Курс, Кратность.
//
Функция НоваяТаблицаКурсов()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("КодВалюты",    Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(3)));
	Таблица.Колонки.Добавить("ЦифровойКод",  Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(10)));
	Таблица.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
	Таблица.Колонки.Добавить("Курс",         Новый ОписаниеТипов("Число",  Новый КвалификаторыЧисла(20, 10)));
	Таблица.Колонки.Добавить("Кратность",    Новый ОписаниеТипов("Число",  Новый КвалификаторыЧисла(10, 0)));

	Возврат Таблица;

КонецФункции

// Возвращает соответствие кодов валют ссылкам справочника Валюты.
//
// Параметры:
//  Знач КодыВалют - Массив - буквенные коды валют из ответа сервиса.
//  Знач ТолькоЗагружаемые - Булево - отбирать только валюты с признаком ЗагружаетсяИзИнтернета.
//
// Возвращаемое значение:
//  Соответствие - ключ: Строка (код валюты в верхнем регистре), значение: СправочникСсылка.Валюты.
//
Функция ВалютыПоКодам(Знач КодыВалют, Знач ТолькоЗагружаемые)

	Результат = Новый Соответствие;

	Если КодыВалют.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	// <query> Одним запросом на весь пакет, без обращения к базе в цикле
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Валюты.Ссылка КАК Ссылка,
	|	Валюты.Код КАК Код
	|ИЗ
	|	Справочник.Валюты КАК Валюты
	|ГДЕ
	|	Валюты.Код В (&КодыВалют)
	|	И НЕ Валюты.ПометкаУдаления
	|	И (НЕ &ТолькоЗагружаемые ИЛИ Валюты.ЗагружаетсяИзИнтернета)";

	Запрос.УстановитьПараметр("КодыВалют",        КодыВалют);
	Запрос.УстановитьПараметр("ТолькоЗагружаемые", ТолькоЗагружаемые);

	Выборка = Запрос.Выполнить().Выбрать();
	// </query>

	Пока Выборка.Следующий() Цикл
		Результат.Вставить(ВРег(СокрЛП(Выборка.Код)), Выборка.Ссылка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Записывает курс одной валюты в регистр сведений.
// Исключения не перехватываются: их обрабатывает вызывающий код.
//
// Параметры:
//  Знач Валюта    - СправочникСсылка.Валюты - валюта.
//  Знач ДатаКурса - Дата   - период записи.
//  Знач Курс      - Число  - курс за Кратность единиц.
//  Знач Кратность - Число  - кратность.
//
Процедура ЗаписатьКурсВалюты(Знач Валюта, Знач ДатаКурса, Знач Курс, Знач Кратность)

	НаборЗаписей = РегистрыСведений.КурсыВалют.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Период.Установить(ДатаКурса);
	НаборЗаписей.Отбор.Валюта.Установить(Валюта);

	Запись = НаборЗаписей.Добавить();
	Запись.Период    = ДатаКурса;
	Запись.Валюта    = Валюта;
	Запись.Курс      = Курс;
	Запись.Кратность = Кратность;

	НаборЗаписей.Записать(Истина);

КонецПроцедуры

// Записывает курс валюты с повторными попытками при временных ошибках записи.
// Блокировка и взаимоблокировка проходят сами - их повторяем. Нарушение прав
// или ограничений данных повтором не лечится - такие ошибки возвращаем сразу.
//
// Параметры:
//  Знач Валюта      - СправочникСсылка.Валюты - валюта.
//  Знач ДатаКурса   - Дата      - период записи.
//  Знач СтрокаКурса - СтрокаТаблицыЗначений - разобранные значения курса.
//  ОписаниеОшибки   - Строка    - возвращаемое описание ошибки, если запись не удалась.
//
// Возвращаемое значение:
//  Булево - Истина, если запись выполнена.
//
Функция ЗаписатьКурсСПовторами(Знач Валюта, Знач ДатаКурса, Знач СтрокаКурса, ОписаниеОшибки)

	// Блокировки живут секунды, поэтому попыток немного и паузы короткие:
	// затягивать запись одной валюты нельзя, впереди весь остальной пакет.
	КоличествоПопыток   = 3;
	ПаузаМеждуПопытками = 2;

	Для НомерПопытки = 1 По КоличествоПопыток Цикл

		// <error> Ошибка записи одной валюты не должна прерывать загрузку остальных - not delete
		Попытка

			ЗаписатьКурсВалюты(Валюта, ДатаКурса, СтрокаКурса.Курс, СтрокаКурса.Кратность);
			ЗафиксироватьУспешнуюЗапись(Валюта, СтрокаКурса, НомерПопытки, КоличествоПопыток);

			ОписаниеОшибки = "";
			Возврат Истина;

		Исключение

			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ОписаниеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке);

			// Повторяем только блокировки: нарушение прав или ограничений
			// целостности при повторе даст ту же ошибку.
			ОшибкаБлокировки = ЭтоОшибкаБлокировки(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
			БудетПовтор = ОшибкаБлокировки И НомерПопытки < КоличествоПопыток;

			КонтекстОшибки = Новый Структура;
			КонтекстОшибки.Вставить("Валюта",             Валюта);
			КонтекстОшибки.Вставить("ДатаКурса",          ДатаКурса);
			КонтекстОшибки.Вставить("СтрокаКурса",        СтрокаКурса);
			КонтекстОшибки.Вставить("ИнформацияОбОшибке", ИнформацияОбОшибке);
			КонтекстОшибки.Вставить("НомерПопытки",       НомерПопытки);
			КонтекстОшибки.Вставить("КоличествоПопыток",  КоличествоПопыток);
			КонтекстОшибки.Вставить("ОшибкаБлокировки",   ОшибкаБлокировки);
			КонтекстОшибки.Вставить("БудетПовтор",        БудетПовтор);

			ЗафиксироватьОшибкуЗаписи(КонтекстОшибки);

			Если Не БудетПовтор Тогда
				Возврат Ложь;
			КонецЕсли;

			ВыполнитьПаузуПередПовторомЗаписи(ПаузаМеждуПопытками * НомерПопытки);

		КонецПопытки;
		// </error>

	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Фиксирует в журнале успешную запись, потребовавшую повторных попыток.
// Однократный успех с первой попытки не логируется: итог пишется по всей загрузке.
//
// Параметры:
//  Знач Валюта            - СправочникСсылка.Валюты - валюта.
//  Знач СтрокаКурса       - СтрокаТаблицыЗначений   - разобранные значения курса.
//  Знач НомерПопытки      - Число - номер удачной попытки.
//  Знач КоличествоПопыток - Число - общее число попыток.
//
Процедура ЗафиксироватьУспешнуюЗапись(Знач Валюта, Знач СтрокаКурса,
	Знач НомерПопытки, Знач КоличествоПопыток)

	Если НомерПопытки = 1 Тогда
		Возврат;
	КонецЕсли;

	ТекстСообщения = СтрШаблон(
		НСтр("ru = 'Курс валюты %1 записан с попытки %2 из %3
			|(предыдущие попытки блокировались).'"),
		СтрокаКурса.КодВалюты,
		НомерПопытки,
		КоличествоПопыток);

	ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Информация, ТекстСообщения, Валюта);

КонецПроцедуры

// Фиксирует в журнале ошибку записи курса одной валюты.
//
// Параметры:
//  Знач КонтекстОшибки - Структура - сведения о неудачной попытке записи:
//   * Валюта             - СправочникСсылка.Валюты - валюта.
//   * ДатаКурса          - Дата   - период записи.
//   * СтрокаКурса        - СтрокаТаблицыЗначений - разобранные значения курса.
//   * ИнформацияОбОшибке - ИнформацияОбОшибке - сведения об ошибке.
//   * НомерПопытки       - Число  - номер попытки.
//   * КоличествоПопыток  - Число  - общее число попыток.
//   * ОшибкаБлокировки   - Булево - Истина, если ошибка вызвана блокировкой.
//   * БудетПовтор        - Булево - Истина, если будет выполнена повторная попытка.
//
Процедура ЗафиксироватьОшибкуЗаписи(Знач КонтекстОшибки)

	Если КонтекстОшибки.ОшибкаБлокировки Тогда
		Характер = НСтр("ru = 'временная блокировка регистра'");
	Иначе
		Характер = НСтр("ru = 'постоянная ошибка: права доступа или ограничения данных'");
	КонецЕсли;

	Если КонтекстОшибки.БудетПовтор Тогда
		Уровень  = УровеньЖурналаРегистрации.Предупреждение;
		Действие = НСтр("ru = 'повтор записи после короткой паузы'");
	Иначе
		Уровень  = УровеньЖурналаРегистрации.Ошибка;
		Действие = НСтр("ru = 'валюта пропущена, загрузка остальных продолжена'");
	КонецЕсли;

	Диагностика = ПодробноеПредставлениеОшибки(КонтекстОшибки.ИнформацияОбОшибке);

	ТекстСообщения = СтрШаблон(
		НСтр("ru = 'Не удалось записать курс валюты %1 на %2.
			|Попытка %3 из %4
			|Характер: %5
			|Действие: %6
			|
			|Диагностика:
			|%7'"),
		КонтекстОшибки.СтрокаКурса.КодВалюты,
		Формат(КонтекстОшибки.ДатаКурса, "ДФ=dd.MM.yyyy"),
		КонтекстОшибки.НомерПопытки,
		КонтекстОшибки.КоличествоПопыток,
		Характер,
		Действие,
		Диагностика);

	// <log> Каждая ошибка записи попадает в журнал регистрации - not delete
	ЗаписатьВЖурнал(Уровень, ТекстСообщения, КонтекстОшибки.Валюта);
	// </log>

КонецПроцедуры

// Выдерживает паузу перед повторной попыткой записи в регистр.
//
// Параметры:
//  Знач Задержка - Число - время ожидания, секунд.
//
Процедура ВыполнитьПаузуПередПовторомЗаписи(Знач Задержка)

	// <error> Сбой паузы не должен прерывать запись - not delete
	Попытка
		Пауза(Задержка);
	Исключение
		// Повтор без паузы: шанс на успех меньше, но отказываться от него незачем.
		ЗаписатьВЖурнал(
			УровеньЖурналаРегистрации.Информация,
			СтрШаблон(НСтр("ru = 'Пауза перед повтором записи не выдержана,
				|повтор выполняется сразу.
				|%1'"),
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	// </error>

КонецПроцедуры

// Определяет, вызвана ли ошибка записи временной блокировкой данных.
//
// Параметры:
//  Знач ТекстОшибки - Строка - подробное представление ошибки.
//
// Возвращаемое значение:
//  Булево - Истина, если ошибка вызвана блокировкой и повтор оправдан.
//
Функция ЭтоОшибкаБлокировки(Знач ТекстОшибки)

	Если ТипЗнч(ТекстОшибки) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;

	ТекстДляПоиска = НРег(ТекстОшибки);

	// Тексты различаются по СУБД и версиям платформы, поэтому список избыточен.
	ПризнакиБлокировки = "заблокирован,блокировка,взаимоблокировка,конфликт блокировок,"
		+ "lock,deadlock,timeout expired,превышено время ожидания";

	Для Каждого Признак Из СтрРазделить(ПризнакиБлокировки, ",", Ложь) Цикл
		Если СтрНайти(ТекстДляПоиска, СокрЛП(Признак)) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Записывает ошибку разбора в журнал регистрации с классификацией и рекомендацией.
//
// Параметры:
//  Знач ВидСбоя     - Строка - вид сбоя, см. ЗагрузкаКурсовВалютЦБКлиентСервер.ВидыСбоев().
//  Знач ТекстОшибки - Строка - описание ошибки и диагностические данные.
//
Процедура ЗафиксироватьОшибкуРазбора(Знач ВидСбоя, Знач ТекстОшибки)

	Реакция = ЗагрузкаКурсовВалютЦБКлиентСервер.РеакцияНаСбой(ВидСбоя);

	// <log> Ошибки разбора фиксируются отдельно от сетевых - not delete
	ЗаписатьВЖурнал(
		УровеньЖурналаРегистрации.Ошибка,
		СтрШаблон(НСтр("ru = 'Загрузка курсов валют не выполнена: ответ сервиса не разобран.
			|
			|Вид сбоя: %1
			|Характер: %2
			|
			|Диагностика:
			|%3
			|
			|Что делать:
			|%4'"),
			ВидСбоя,
			?(Реакция.Временный,
				НСтр("ru = 'временная проблема'"),
				НСтр("ru = 'постоянная проблема, повтор загрузки не поможет'")),
			ТекстОшибки,
			Реакция.Рекомендация));
	// </log>

КонецПроцедуры

// Возвращает безопасный для журнала фрагмент начала ответа сервиса.
// Помогает дежурному сразу увидеть, что пришло вместо данных: страница
// авторизации прокси, заглушка или текст ошибки.
//
// Параметры:
//  Знач ТекстОтвета - Строка - текст ответа сервиса.
//
// Возвращаемое значение:
//  Строка - фрагмент ответа, ограниченный по длине.
//
Функция ФрагментОтветаДляЖурнала(Знач ТекстОтвета)

	// Длина ограничена намеренно: полный ответ сервиса раздувает журнал,
	// а для распознавания заглушки достаточно первых строк.
	ПредельнаяДлина = 500;

	Если ТипЗнч(ТекстОтвета) <> Тип("Строка") Или ПустаяСтрока(ТекстОтвета) Тогда
		Возврат НСтр("ru = '<ответ пуст>'");
	КонецЕсли;

	Фрагмент = СокрЛП(ТекстОтвета);

	// Сервис ЦБ РФ работает без аутентификации, но при смене источника в теле
	// ответа могут оказаться токены. Маскируем их до записи в журнал.
	Фрагмент = ЗамаскироватьЧувствительныеДанные(Фрагмент);

	Если СтрДлина(Фрагмент) > ПредельнаяДлина Тогда
		Фрагмент = Лев(Фрагмент, ПредельнаяДлина) + НСтр("ru = '... <фрагмент обрезан>'");
	КонецЕсли;

	Возврат Фрагмент;

КонецФункции

// Маскирует значения, похожие на токены и ключи доступа.
// Вызывается перед записью в журнал регистрации любых внешних данных.
//
// Параметры:
//  Знач Текст - Строка - исходный текст.
//
// Возвращаемое значение:
//  Строка - текст с замаскированными значениями чувствительных параметров.
//
Функция ЗамаскироватьЧувствительныеДанные(Знач Текст)

	Результат = Текст;

	// Имена параметров, значения которых не должны попадать в журнал.
	// Список закрывает типовые варианты в XML, JSON и строке запроса.
	ЧувствительныеИмена = "token,access_token,api_key,apikey,key,password,pwd,secret,"
		+ "authorization,токен,пароль,ключ";

	Для Каждого Имя Из СтрРазделить(ЧувствительныеИмена, ",", Ложь) Цикл
		Результат = ЗамаскироватьЗначениеПараметра(Результат, СокрЛП(Имя));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Заменяет значение указанного параметра на маркер сокрытия.
// Обрабатывает формы записи: имя="значение", имя=значение, <имя>значение</имя>.
//
// Параметры:
//  Знач Текст - Строка - исходный текст.
//  Знач ИмяПараметра - Строка - имя параметра, значение которого маскируется.
//
// Возвращаемое значение:
//  Строка - текст с замаскированным значением.
//
Функция ЗамаскироватьЗначениеПараметра(Знач Текст, Знач ИмяПараметра)

	Результат = Текст;
	Маркер = "<скрыто>";

	// Форма <имя>значение</имя>
	ОткрывающийТег = "<" + ИмяПараметра + ">";
	ЗакрывающийТег = "</" + ИмяПараметра + ">";

	ПозицияНачала = СтрНайти(НРег(Результат), НРег(ОткрывающийТег));
	Пока ПозицияНачала > 0 Цикл
		ПозицияКонца = СтрНайти(НРег(Результат), НРег(ЗакрывающийТег), , ПозицияНачала);
		Если ПозицияКонца = 0 Тогда
			Прервать;
		КонецЕсли;

		НачалоЗначения = ПозицияНачала + СтрДлина(ОткрывающийТег);
		Результат = Лев(Результат, НачалоЗначения - 1) + Маркер + Сред(Результат, ПозицияКонца);

		ПозицияНачала = СтрНайти(НРег(Результат), НРег(ОткрывающийТег),
			, НачалоЗначения + СтрДлина(Маркер));
	КонецЦикла;

	// Формы имя="значение" и имя=значение
	Результат = ЗамаскироватьПрисваивание(Результат, ИмяПараметра, Маркер);

	Возврат Результат;

КонецФункции

// Маскирует значение в конструкции вида имя="значение" или имя=значение.
//
// Параметры:
//  Знач Текст        - Строка - исходный текст.
//  Знач ИмяПараметра - Строка - имя параметра.
//  Знач Маркер       - Строка - текст, заменяющий значение.
//
// Возвращаемое значение:
//  Строка - текст с замаскированным значением.
//
Функция ЗамаскироватьПрисваивание(Знач Текст, Знач ИмяПараметра, Знач Маркер)

	Результат = Текст;
	Образец = ИмяПараметра + "=";

	ПозицияПоиска = 1;

	Пока Истина Цикл

		ПозицияИмени = СтрНайти(НРег(Результат), НРег(Образец), , ПозицияПоиска);
		Если ПозицияИмени = 0 Тогда
			Прервать;
		КонецЕсли;

		НачалоЗначения = ПозицияИмени + СтрДлина(Образец);
		ОстатокТекста = Сред(Результат, НачалоЗначения);

		Если ПустаяСтрока(ОстатокТекста) Тогда
			Прервать;
		КонецЕсли;

		ПервыйСимвол = Лев(ОстатокТекста, 1);

		Если ПервыйСимвол = """" Или ПервыйСимвол = "'" Тогда
			// Значение в кавычках: ищем закрывающую.
			ДлинаЗначения = СтрНайти(Сред(ОстатокТекста, 2), ПервыйСимвол);
			Если ДлинаЗначения = 0 Тогда
				Прервать;
			КонецЕсли;
			ЗаменяемыйФрагмент = Лев(ОстатокТекста, ДлинаЗначения + 1);
			НовыйФрагмент = ПервыйСимвол + Маркер + ПервыйСимвол;
		Иначе
			// Значение до ближайшего разделителя.
			ДлинаЗначения = 0;
			Для НомерСимвола = 1 По СтрДлина(ОстатокТекста) Цикл
				Символ = Сред(ОстатокТекста, НомерСимвола, 1);
				Если СтрНайти(" &<>" + Символы.ПС + Символы.Таб, Символ) > 0 Тогда
					Прервать;
				КонецЕсли;
				ДлинаЗначения = НомерСимвола;
			КонецЦикла;

			Если ДлинаЗначения = 0 Тогда
				ПозицияПоиска = НачалоЗначения;
				Продолжить;
			КонецЕсли;

			ЗаменяемыйФрагмент = Лев(ОстатокТекста, ДлинаЗначения);
			НовыйФрагмент = Маркер;
		КонецЕсли;

		Результат = Лев(Результат, НачалоЗначения - 1) + НовыйФрагмент
			+ Сред(ОстатокТекста, СтрДлина(ЗаменяемыйФрагмент) + 1);

		ПозицияПоиска = НачалоЗначения + СтрДлина(НовыйФрагмент);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает адрес сервиса для записи в журнал регистрации.
// Отдельная функция нужна, чтобы в журнал не попадали параметры строки запроса:
// у ЦБ РФ их нет, но при смене источника там могут оказаться ключи доступа.
//
// Параметры:
//  Знач Параметры - Структура - см. ПараметрыПодключения().
//
// Возвращаемое значение:
//  Строка - адрес без параметров запроса.
//
Функция БезопасныйАдресДляЖурнала(Знач Параметры)

	Адрес = ?(Параметры.ЗащищенноеСоединение, "https://", "http://")
		+ Параметры.Сервер + Параметры.АдресРесурса;

	ПозицияПараметров = СтрНайти(Адрес, "?");
	Если ПозицияПараметров > 0 Тогда
		Адрес = Лев(Адрес, ПозицияПараметров - 1) + "?<параметры скрыты>";
	КонецЕсли;

	Возврат Адрес;

КонецФункции

#КонецОбласти
