#Область ПрограммныйИнтерфейс

// Обрабатывает список заказов: применяет скидку и проводит документы.
// Используется в регламентном задании «Ночная обработка заказов».
//
Процедура ОбработатьЗаказы(ДатаНач, ДатаКон, ВидЦены) Экспорт

	q = Новый Запрос;
	q.Текст =
		"ВЫБРАТЬ
		|	Реализация.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК Реализация
		|ГДЕ
		|	Реализация.Дата МЕЖДУ &ДН И &ДК
		|	И Реализация.Проведен = ЛОЖЬ";

	q.УстановитьПараметр("ДН", ДатаНач);
	q.УстановитьПараметр("ДК", ДатаКон);

	Рез = q.Выполнить().Выбрать();

	Пока Рез.Следующий() Цикл

		Д1 = Рез.Ссылка.ПолучитьОбъект();

		// Получаем контрагента из справочника (для определения категории и скидки)
		qКонтр = Новый Запрос;
		qКонтр.Текст =
			"ВЫБРАТЬ
			|	Контрагенты.Категория КАК Категория,
			|	Контрагенты.Договор КАК Договор
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты
			|ГДЕ
			|	Контрагенты.Ссылка = &Ссылка";
		qКонтр.УстановитьПараметр("Ссылка", Д1.Контрагент);
		РезК = qКонтр.Выполнить().Выбрать();
		РезК.Следующий();

		// Считаем скидку через расчёт скидок
		ПроцСк = РасчётСкидок.РассчитатьСкидку(
			Д1.Контрагент, РезК.Договор, Д1.СуммаДокумента, Д1.Дата);

		// Применяем скидку к строкам
		Для Каждого Стр Из Д1.Товары Цикл
			Стр.ПроцентСкидки = ПроцСк;
			Стр.СуммаСкидки = Стр.Сумма * ПроцСк / 100;
			Стр.Сумма = Стр.Сумма - Стр.СуммаСкидки;

			// Дополнительная скидка для крупных заказов
			Если Д1.СуммаДокумента > 100000 Тогда
				Стр.Сумма = Стр.Сумма * 0.95;
			КонецЕсли;
		КонецЦикла;

		Д1.СуммаДокумента = Д1.Товары.Итог("Сумма");
		Д1.Записать(РежимЗаписиДокумента.Проведение);

	КонецЦикла;

КонецПроцедуры

// Пересчитывает итоги по контрагенту за период.
// Вызывается из обработчика регламентного задания и при ручном пересчёте.
//
Функция ПересчитатьИтогиПоКонтрагенту(Контрагент, Период) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СУММА(Продажи.Сумма) КАК Сумма
		|ИЗ
		|	РегистрНакопления.Продажи КАК Продажи
		|ГДЕ
		|	Продажи.Контрагент = &Контрагент
		|	И Продажи.Период МЕЖДУ &НачПер И &КонПер";

	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("НачПер", НачалоМесяца(Период));
	Запрос.УстановитьПараметр("КонПер", КонецМесяца(Период));

	Результат = Запрос.Выполнить().Выгрузить();

	Если Результат.Количество() > 0 Тогда
		Возврат Результат[0].Сумма;
	Иначе
		Возврат 0;
	КонецЕсли;

КонецФункции

#КонецОбласти
