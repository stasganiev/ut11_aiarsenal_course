// Общий модуль ОбработкаЗаказов (Сервер)
// Сквозная подсистема "Ценообразование и скидки" - продолжение Уроков 11-13.
//
// ВНИМАНИЕ: этот код - учебный материал для Урока 14 "Code Review с AI".
// В нем СПЕЦИАЛЬНО заложены проблемы трех категорий:
//  - Стандарты и баги (магические числа, имена, двойное применение скидки)
//  - Производительность (запрос в цикле, ПолучитьОбъект+Записать в цикле)
//  - Безопасность (нет проверки прав, нет транзакции, нет валидации входов)

#Область ПрограммныйИнтерфейс

// Обрабатывает непроведенные реализации за период: применяет скидку и проводит.
// Используется в регламентном задании "Ночная обработка заказов".
//
// Параметры:
//  ДатаНачала    - Дата - начало периода отбора (включительно), приводится к началу дня.
//  ДатаОкончания - Дата - окончание периода отбора (включительно), приводится к концу дня.
//  ВидЦены       - СправочникСсылка.ВидыЦен - вид цены для расчета скидки.
//                  ВНИМАНИЕ: параметр объявлен, но еще не задействован в логике расчета.
//                  Решение о способе применения остается за разработчиком.
//
// Пример:
//  ОбработкаЗаказов.ОбработатьЗаказы(НачалоДня(ТекущаяДата()), КонецДня(ТекущаяДата()), ВидЦены);
//
Процедура ОбработатьЗаказы(ДатаНачала, ДатаОкончания, ВидЦены) Экспорт

	// --- Проверка прав ---
	Если НЕ ПравоДоступа("Изменение", Метаданные.Документы.РеализацияТоваровУслуг) Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав для пакетной обработки заказов'");
	КонецЕсли;

	// --- Валидация входных параметров ---
	Если НЕ ЗначениеЗаполнено(ДатаНачала) ИЛИ НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		ВызватьИсключение НСтр("ru = 'Параметры ДатаНачала и ДатаОкончания обязательны'");
	КонецЕсли;
	Если ДатаНачала > ДатаОкончания Тогда
		ВызватьИсключение НСтр("ru = 'ДатаНачала не может быть больше ДатаОкончания'");
	КонецЕсли;

	// Нормализуем даты к границам суток, чтобы не "срезать" документы по времени.
	ДатаОтбораНач = НачалоДня(ДатаНачала);
	ДатаОтбораКон = КонецДня(ДатаОкончания);

	// Порог крупного заказа. TODO: вынести в константу или настройки подсистемы "Ценообразование".
	// ЗАМЕЧАНИЕ ревью (1.1, P6): значение 100000 - магическое число, рекомендуется константа/настройка.
	ПорогКрупногоЗаказа = 100000;

	// Коэффициент дополнительной скидки для крупных заказов.
	// ЗАМЕЧАНИЕ ревью (1.1, 3.1): 0.95 соответствует скидке 5%, зашито в код.
	// ЗАМЕЧАНИЕ ревью (1.1): при ПроцентСкидки > 0 к строке применяются ДВЕ скидки подряд:
	// сначала через РасчетСкидок, потом *КоэффициентСкидкиКрупногоЗаказа.
	// Поле СуммаСкидки отражает только первую скидку. Бизнес-решение за разработчиком.
	//
	// ЗАМЕЧАНИЕ ревью (1.2): после правки СтрокаТовара.Сумма реквизиты Цена, СуммаНДС, СуммаСНДС
	// не пересчитываются. Рекомендуется использовать штатные процедуры пересчета УТ 11.5.
	// Бизнес-решение за разработчиком.
	КоэффициентСкидкиКрупногоЗаказа = 0.95;

	// Имя события журнала регистрации - выносим в переменную, чтобы не дублировать строковый литерал.
	ИмяСобытияЖурнала = "ОбработкаЗаказов";
	МетаданныеДокумента = Метаданные.Документы.РеализацияТоваровУслуг;

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		// Основной запрос: читаем все непроведенные реализации в периоде.
		// Реквизиты контрагента берем соединением - устраняет запрос в цикле (N+1).
		// Выгружаем в таблицу значений до начала цикла записи, чтобы закрыть курсор
		// и не держать его открытым во время транзакций (устраняет deadlock P4).
		// УПОРЯДОЧИТЬ ПО Ссылка - детерминированный порядок блокировок, исключает deadlock (C1).
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Реализация.Ссылка КАК Ссылка,
			|	Реализация.Контрагент КАК Контрагент,
			|	Реализация.СуммаДокумента КАК СуммаДокумента,
			|	Контрагенты.Договор КАК Договор
			|ИЗ
			|	Документ.РеализацияТоваровУслуг КАК Реализация
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
			|		ПО Реализация.Контрагент = Контрагенты.Ссылка
			|ГДЕ
			|	Реализация.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
			|	И НЕ Реализация.Проведен
			|	И НЕ Реализация.ПометкаУдаления
			|УПОРЯДОЧИТЬ ПО
			|	Реализация.Ссылка";

		Запрос.УстановитьПараметр("ДатаНачала", ДатаОтбораНач);
		Запрос.УстановитьПараметр("ДатаОкончания", ДатаОтбораКон);

		ПланОбработки = Запрос.Выполнить().Выгрузить();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	СчетчикОбработанных = 0;

	ЗаписьЖурналаРегистрации(
		ИмяСобытияЖурнала,
		УровеньЖурналаРегистрации.Информация,
		МетаданныеДокумента,
		,
		СтрШаблон("Старт обработки. Документов в выборке: %1", ПланОбработки.Количество()));

	Для Каждого СтрокаПлана Из ПланОбработки Цикл

		СсылкаДокумента = СтрокаПлана.Ссылка;

		// Проверяем, что договор найден (контрагент мог не найтись при левом соединении).
		Если НЕ ЗначениеЗаполнено(СтрокаПлана.Договор) Тогда
			ЗаписьЖурналаРегистрации(
				ИмяСобытияЖурнала,
				УровеньЖурналаРегистрации.Предупреждение,
				МетаданныеДокумента,
				СсылкаДокумента,
				"Договор контрагента не найден, документ пропущен");
			Продолжить;
		КонецЕсли;

		// Каждый документ обрабатываем в отдельной транзакции,
		// чтобы ошибка одного документа не остановила всю пачку.
		НачатьТранзакцию();
		Попытка

			// Управляемая блокировка документа перед чтением - защита от гонки (Lost Update, B1).
			// Порядок по Ссылка (см. УПОРЯДОЧИТЬ в запросе) исключает deadlock между сеансами (C1).
			БлокировкаДанных = Новый БлокировкаДанных;
			ЭлементБлокировки = БлокировкаДанных.Добавить("Документ.РеализацияТоваровУслуг");
			ЭлементБлокировки.УстановитьЗначение("Ссылка", СсылкаДокумента);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			БлокировкаДанных.Заблокировать();

			ДокументОбъект = СсылкаДокумента.ПолучитьОбъект();

			// Перепроверяем состояние после блокировки:
			// другой сеанс мог провести или пометить на удаление за время между выборкой и блокировкой.
			Если ДокументОбъект.Проведен ИЛИ ДокументОбъект.ПометкаУдаления Тогда
				ОтменитьТранзакцию();
				Продолжить;
			КонецЕсли;

			// Считаем скидку через модуль расчета скидок.
			ПроцентСкидки = РасчетСкидок.РассчитатьСкидку(
				ДокументОбъект.Контрагент,
				СтрокаПлана.Договор,
				ДокументОбъект.СуммаДокумента,
				ДокументОбъект.Дата);

			// Кешируем признак крупного заказа до цикла - инвариант цикла (P6).
			// ЗАМЕЧАНИЕ ревью (1.1): см. выше - два уровня скидок применяются последовательно.
			ЯвляетсяКрупнымЗаказом = ДокументОбъект.СуммаДокумента > ПорогКрупногоЗаказа;

			// Применяем скидку к строкам; накапливаем новую сумму документа в переменной
			// (устраняет второй проход через Итог("Сумма"), P5).
			ДелительПроцентов = 100;
			НоваяСуммаДокумента = 0;
			Для Каждого СтрокаТовара Из ДокументОбъект.Товары Цикл
				СтрокаТовара.ПроцентСкидки = ПроцентСкидки;
				СтрокаТовара.СуммаСкидки   = СтрокаТовара.Сумма * ПроцентСкидки / ДелительПроцентов;
				СтрокаТовара.Сумма          = СтрокаТовара.Сумма - СтрокаТовара.СуммаСкидки;

				// Дополнительная скидка для крупных заказов.
				// ЗАМЕЧАНИЕ ревью (1.1): вторая скидка поверх первой; СуммаСкидки
				// итоговое удержание не отражает. Бизнес-решение за разработчиком.
				Если ЯвляетсяКрупнымЗаказом Тогда
					СтрокаТовара.Сумма = СтрокаТовара.Сумма * КоэффициентСкидкиКрупногоЗаказа;
				КонецЕсли;

				НоваяСуммаДокумента = НоваяСуммаДокумента + СтрокаТовара.Сумма;
			КонецЦикла;

			ДокументОбъект.СуммаДокумента = НоваяСуммаДокумента;

			// ЗАМЕЧАНИЕ ревью (B3): при участии в планах обмена каждая запись регистрирует движение.
			// Если обработанные документы не должны реплицироваться -
			// установить ДокументОбъект.ОбменДанными.Загрузка = Истина. Решение за разработчиком.
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);

			СчетчикОбработанных = СчетчикОбработанных + 1;

			ЗаписьЖурналаРегистрации(
				ИмяСобытияЖурнала,
				УровеньЖурналаРегистрации.Информация,
				МетаданныеДокумента,
				СсылкаДокумента,
				"Документ обработан и проведен");

			ЗафиксироватьТранзакцию();

		Исключение
			ОтменитьТранзакцию();
			ТекстОшибки = ИнформацияОбОшибке().Описание;
			ЗаписьЖурналаРегистрации(
				ИмяСобытияЖурнала,
				УровеньЖурналаРегистрации.Ошибка,
				МетаданныеДокумента,
				СсылкаДокумента,
				ТекстОшибки);
		КонецПопытки;

	КонецЦикла;

	КоличествоВВыборке = ПланОбработки.Количество();
	ЗаписьЖурналаРегистрации(
		ИмяСобытияЖурнала,
		УровеньЖурналаРегистрации.Информация,
		МетаданныеДокумента,
		,
		СтрШаблон("Финиш обработки. Обработано документов: %1 из %2",
			СчетчикОбработанных, КоличествоВВыборке));

КонецПроцедуры

// Пересчитывает итоги продаж по контрагенту за месяц, в который входит указанная дата.
// Вызывается из обработчика регламентного задания и при ручном пересчете.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты - контрагент для отбора. Должен быть заполнен.
//  Период     - Дата - любая дата внутри нужного месяца. Должна быть типа Дата.
//
// Возвращаемое значение:
//  Число - сумма выручки за месяц, или 0 если движений нет.
//
// Пример:
//  Итог = ОбработкаЗаказов.ПересчитатьИтогиПоКонтрагенту(Контрагент, ТекущаяДата());
//
Функция ПересчитатьИтогиПоКонтрагенту(Контрагент, Период) Экспорт

	// --- Валидация входных параметров ---
	Если НЕ ЗначениеЗаполнено(Период) ИЛИ ТипЗнч(Период) <> Тип("Дата") Тогда
		ВызватьИсключение НСтр("ru = 'Не указан период для пересчета итогов'");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		ВызватьИсключение НСтр("ru = 'Не указан контрагент для пересчета итогов'");
	КонецЕсли;

	// ЗАМЕЧАНИЕ ревью (A2): привилегированный режим позволяет читать данные в обход RLS.
	// Если функция доступна пользователям (не только регламентам), это создает утечку
	// коммерческих данных. Решение о необходимости привилегий - за разработчиком.
	// Режим включается и выключается парно, на минимальный фрагмент кода (1.6).
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		// Используем виртуальную таблицу Обороты() с параметрами фильтрации внутри скобок -
		// это на порядки быстрее чтения основной таблицы регистра (P7).
		// ЕСТЬNULL гарантирует возврат 0 при отсутствии движений (1.7).
		// ЗАМЕЧАНИЕ: в данной конфигурации УТ 11.5 нет регистра "Продажи" - используется
		// "ВыручкаИСебестоимостьПродаж". Фильтр по Контрагенту требует предварительного
		// получения ключей аналитики: разыменование в параметре виртуальной таблицы
		// и соединение с виртуальной таблицей запрещены стандартом (два отдельных запроса).
		НачалоПериода = НачалоМесяца(Период);
		КонецПериода  = КонецМесяца(Период);

		// Шаг 1: получаем ключи аналитики для контрагента из регистра сведений.
		ЗапросАналитики = Новый Запрос;
		ЗапросАналитики.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Аналитика.КлючАналитики КАК КлючАналитики
			|ИЗ
			|	РегистрСведений.АналитикаУчетаПоПартнерам КАК Аналитика
			|ГДЕ
			|	Аналитика.Контрагент = &Контрагент";
		ЗапросАналитики.УстановитьПараметр("Контрагент", Контрагент);
		КлючиАналитики = ЗапросАналитики.Выполнить().Выгрузить().ВыгрузитьКолонку("КлючАналитики");

		// Шаг 2: запрашиваем обороты с фильтром по полученным ключам в параметре виртуальной таблицы.
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЕСТЬNULL(СУММА(Обороты.СуммаВыручкиОборот), 0) КАК Сумма
			|ИЗ
			|	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(
			|		&НачалоПериода, &КонецПериода, Авто,
			|		АналитикаУчетаПоПартнерам В (&КлючиАналитики)) КАК Обороты";

		Запрос.УстановитьПараметр("КлючиАналитики", КлючиАналитики);
		Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
		Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

		Результат = Запрос.Выполнить().Выгрузить();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	// Агрегатный запрос без СГРУППИРОВАТЬ ПО всегда возвращает ровно одну строку (1.7).
	Возврат Результат[0].Сумма;

КонецФункции

#КонецОбласти
