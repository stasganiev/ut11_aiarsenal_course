#Область ПрограммныйИнтерфейс

Функция РассчитатьСкидку(Клиент, Договор, СуммаЗаказа, ДатаЗаказа) Экспорт

	Скидка = ПолучитьБазовуюСкидку(Договор);

	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Клиент, "VIP") Тогда
		Скидка = Скидка + 5;
	КонецЕсли;

	Если СуммаЗаказа > 100000 Тогда
		Скидка = Скидка + 5;
	КонецЕсли;

	Если ПроверитьУсловиеАкции(ДатаЗаказа) Тогда
		Скидка = Скидка + 3;
	КонецЕсли;

	Возврат ОграничитьМаксимальнуюСкидку(Скидка);

КонецФункции

Процедура ПрименитьСкидкуКДокументу(ДокументОбъект) Экспорт

	Если ДокументОбъект.Товары.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ПроцентСкидки = РассчитатьСкидку(
		ДокументОбъект.Контрагент,
		ДокументОбъект.Договор,
		ДокументОбъект.СуммаДокумента,
		ДокументОбъект.Дата);

	Для Каждого СтрокаТовара Из ДокументОбъект.Товары Цикл
		СтрокаТовара.ПроцентСкидки = ПроцентСкидки;
		СтрокаТовара.СуммаСкидки = СтрокаТовара.Сумма * ПроцентСкидки / 100;
		СтрокаТовара.Сумма = СтрокаТовара.Сумма - СтрокаТовара.СуммаСкидки;
	КонецЦикла;

	ДокументОбъект.СуммаДокумента = ДокументОбъект.Товары.Итог("Сумма");

КонецПроцедуры

Функция ПолучитьАктуальнуюЦену(Номенклатура, ВидЦены, ДатаАктуальности = Неопределено) Экспорт

	Если ДатаАктуальности = Неопределено Тогда
		ДатаАктуальности = ТекущаяДата();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Дата,
		|		Номенклатура = &Номенклатура
		|		И ВидЦены = &ВидЦены) КАК ЦеныНоменклатурыСрезПоследних";

	Запрос.УстановитьПараметр("Дата", ДатаАктуальности);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ВидЦены", ВидЦены);

	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Возврат Результат.Цена;
	КонецЕсли;

	Возврат 0;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьБазовуюСкидку(Договор)

	БазоваяСкидка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "СтавкаДисконтирования");

	Если БазоваяСкидка = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Возврат БазоваяСкидка;

КонецФункции

Функция ПроверитьУсловиеАкции(ДатаЗаказа)

	Если Месяц(ДатаЗаказа) = 12 Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция ОграничитьМаксимальнуюСкидку(Скидка)

	МаксимальнаяСкидка = Константы.МаксимальнаяСкидкаПоУмолчанию.Получить();

	Если Скидка > МаксимальнаяСкидка Тогда
		Возврат МаксимальнаяСкидка;
	КонецЕсли;

	Если Скидка < 0 Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Скидка;

КонецФункции

#КонецОбласти
