#Область ПрограммныйИнтерфейс

Функция ПолучитьИтоговуюЦенуСоСкидкой(Номенклатура, Контрагент, СуммаЗаказа,
		ВидЦены, Договор, Дата) Экспорт

	БазоваяЦена = ПолучитьБазовуюЦену(Номенклатура, ВидЦены, Дата);

	Если БазоваяЦена = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Если ПолучитьФункциональнуюОпцию("УчитыватьИндивидуальныеЦены") Тогда
		ИндивидуальнаяЦена = ПолучитьИндивидуальнуюЦену(Контрагент, Номенклатура);
		Если ИндивидуальнаяЦена > 0 Тогда
			БазоваяЦена = ИндивидуальнаяЦена;
		КонецЕсли;
	КонецЕсли;

	ПроцентСкидки = РасчётСкидок.РассчитатьСкидку(Контрагент, Договор, СуммаЗаказа, Дата);

	ПотолокСкидки = Константы.МаксимальнаяСкидкаПоУмолчанию.Получить();
	Если ПроцентСкидки > ПотолокСкидки Тогда
		ПроцентСкидки = ПотолокСкидки;
	КонецЕсли;

	ИтоговаяЦена = БазоваяЦена * (1 - ПроцентСкидки / 100);

	Возврат ИтоговаяЦена;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьБазовуюЦену(Номенклатура, ВидЦены, Дата)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Дата,
		|		Номенклатура = &Номенклатура
		|		И ВидЦены = &ВидЦены) КАК ЦеныНоменклатурыСрезПоследних";

	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ВидЦены", ВидЦены);

	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Возврат Результат.Цена;
	КонецЕсли;

	Возврат 0;

КонецФункции

Функция ПолучитьИндивидуальнуюЦену(Контрагент, Номенклатура)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СоглашенияОЦенообразовании.ИндивидуальнаяЦена КАК Цена
		|ИЗ
		|	РегистрСведений.СоглашенияОЦенообразовании КАК СоглашенияОЦенообразовании
		|ГДЕ
		|	СоглашенияОЦенообразовании.Контрагент = &Контрагент
		|	И СоглашенияОЦенообразовании.Номенклатура = &Номенклатура
		|	И СоглашенияОЦенообразовании.Активное";

	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);

	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Возврат Результат.Цена;
	КонецЕсли;

	Возврат 0;

КонецФункции

#КонецОбласти
