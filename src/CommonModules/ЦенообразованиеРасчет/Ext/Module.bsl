#Область ПрограммныйИнтерфейс

Функция РассчитатьЦену(Товар, Контрагент, Соглашение, ДатаРасчёта, Количество) Экспорт

	Результат = ПодготовитьСтруктуруРезультата();

	ВидЦены = ПолучитьВидЦеныПоСоглашению(Соглашение);
	БазоваяЦена = ПолучитьБазовуюЦену(Товар, ВидЦены, ДатаРасчёта);

	Если БазоваяЦена = 0 Тогда
		Результат.Основание = "Базовая цена не найдена";
		Возврат Результат;
	КонецЕсли;

	Скидки = ПолучитьСкидкиКонтрагента(Контрагент, ДатаРасчёта);

	Цена = ПрименитьПравилаЦенообразования(БазоваяЦена, Скидки, Соглашение);
	Цена = ПроверитьОграничения(Цена, Соглашение.МинимальнаяЦена, 25);
	Цена = ОкруглитьЦену(Цена, Соглашение.ПравилоОкругления);

	Результат.Цена = Цена;
	Результат.ПроцентСкидки = СвернутьПроцентСкидки(Скидки);
	Результат.ПримененныеСкидки = Скидки;
	Результат.Основание = "Расчёт по соглашению " + Соглашение.Наименование;

	ЗаписатьИсториюРасчёта(Новый Структура("Товар, Контрагент, Цена, Скидки",
		Товар, Контрагент, Цена, Скидки));

	Возврат Результат;

КонецФункции

Функция РассчитатьЦеныДокумента(Документ) Экспорт

	Если Документ.Товары.Количество() = 0 Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;

	Результат = Документ.Товары.Выгрузить();
	Результат.Колонки.Добавить("ИтоговаяЦена");
	Результат.Колонки.Добавить("ПроцентСкидки");

	СуммаДокумента = 0;
	Для Каждого Стр Из Результат Цикл
		РасчётСтроки = РассчитатьЦену(
			Стр.Товар, Документ.Контрагент, Документ.Соглашение,
			Документ.Дата, Стр.Количество);
		Стр.ИтоговаяЦена = РасчётСтроки.Цена;
		Стр.ПроцентСкидки = РасчётСтроки.ПроцентСкидки;
		СуммаДокумента = СуммаДокумента + РасчётСтроки.Цена * Стр.Количество;
	КонецЦикла;

	ОптоваяСкидка = ОптоваяСкидкаПоДокументу(Результат);
	Если ОптоваяСкидка > 0 Тогда
		Для Каждого Стр Из Результат Цикл
			Стр.ИтоговаяЦена = Стр.ИтоговаяЦена * (1 - ОптоваяСкидка / 100);
			Стр.ПроцентСкидки = Стр.ПроцентСкидки + ОптоваяСкидка;
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Процедура ОбновитьЦеныПоСоглашению(Контрагент, ДатаНач, ДатаКон) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СоглашенияТовары.Номенклатура КАК Товар,
		|	СоглашенияТовары.ВидЦены КАК ВидЦены
		|ИЗ
		|	РегистрСведений.СоглашенияОЦенообразовании.СрезПоследних(&ДатаКон, ) КАК СоглашенияТовары
		|ГДЕ
		|	СоглашенияТовары.Контрагент = &Контрагент";

	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("ДатаКон", ДатаКон);
	Выборка = Запрос.Выполнить().Выбрать();

	НачатьТранзакцию();
	Попытка
		Пока Выборка.Следующий() Цикл
			НоваяЦена = ПолучитьБазовуюЦену(Выборка.Товар, Выборка.ВидЦены, ДатаКон);
			ЗаписьЦены = РегистрыСведений.ЦеныНоменклатуры.СоздатьМенеджерЗаписи();
			ЗаписьЦены.Период = ДатаНач;
			ЗаписьЦены.Номенклатура = Выборка.Товар;
			ЗаписьЦены.ВидЦены = Выборка.ВидЦены;
			ЗаписьЦены.Цена = НоваяЦена;
			ЗаписьЦены.Записать();
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Функция РассчитатьСкидку(Клиент, Договор, СуммаЗаказа, ДатаЗаказа) Экспорт

	Скидки = ПолучитьСкидкиКонтрагента(Клиент, ДатаЗаказа);

	ОбщийПроцент = ПолучитьБазовуюСкидку(Договор);
	Для Каждого ЭлементСкидки Из Скидки Цикл
		ОбщийПроцент = ОбщийПроцент + ЭлементСкидки.Процент;
	КонецЦикла;

	Если СуммаЗаказа > 100000 Тогда
		ОбщийПроцент = ОбщийПроцент + 5;
	КонецЕсли;

	Возврат ОграничитьМаксимальнуюСкидку(ОбщийПроцент);

КонецФункции

#КонецОбласти

#Область БазовыеЦены

Функция ПолучитьБазовуюЦену(Товар, ВидЦены, ДатаРасчёта)

	КэшЦен = ПолучитьКэшЦен(Товар, ВидЦены, ДатаРасчёта);
	Если КэшЦен <> Неопределено Тогда
		Возврат КэшЦен;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена,
		|	ЦеныНоменклатурыСрезПоследних.Период КАК Период
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Дата,
		|		Номенклатура = &Номенклатура
		|		И ВидЦены = &ВидЦены) КАК ЦеныНоменклатурыСрезПоследних";

	Запрос.УстановитьПараметр("Дата", ДатаРасчёта);
	Запрос.УстановитьПараметр("Номенклатура", Товар);
	Запрос.УстановитьПараметр("ВидЦены", ВидЦены);

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат 0;
	КонецЕсли;

	Если НЕ ЦенаДействуетНаДату(Выборка, ДатаРасчёта) Тогда
		Возврат 0;
	КонецЕсли;

	ОбновитьКэшЦен(Товар, ВидЦены, ДатаРасчёта, Выборка.Цена);

	Возврат Выборка.Цена;

КонецФункции

Функция ПолучитьВидЦеныПоСоглашению(Соглашение)

	Если НЕ ЗначениеЗаполнено(Соглашение) Тогда
		Возврат Справочники.ВидыЦен.Основная;
	КонецЕсли;

	ВидЦены = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Соглашение, "ВидЦены");
	Если НЕ ЗначениеЗаполнено(ВидЦены) Тогда
		Возврат Справочники.ВидыЦен.Основная;
	КонецЕсли;

	Возврат ВидЦены;

КонецФункции

Функция ЦенаДействуетНаДату(ЗаписьЦены, ДатаПроверки)

	Если ЗаписьЦены.Период > ДатаПроверки Тогда
		Возврат Ложь;
	КонецЕсли;

	РазницаДней = (ДатаПроверки - ЗаписьЦены.Период) / 86400;
	Если РазницаДней > 365 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

#КонецОбласти

#Область Скидки

Функция ПолучитьСкидкиКонтрагента(Контрагент, ДатаРасчёта)

	Скидки = Новый Массив;

	Категория = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "Категория");
	Если Категория = Перечисления.КатегорииКлиентов.VIP Тогда
		ЭлементVIP = Новый Структура("ТипСкидки, Процент, Основание",
			"VIP", 5, "Категория контрагента: VIP");
		Скидки.Добавить(ЭлементVIP);
	КонецЕсли;

	КатегорияПовторно = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "Категория");
	Если КатегорияПовторно = Перечисления.КатегорииКлиентов.Новый Тогда
		ЭлементНовый = Новый Структура("ТипСкидки, Процент, Основание",
			"Новый клиент", 2, "Скидка нового клиента");
		Скидки.Добавить(ЭлементНовый);
	КонецЕсли;

	ПериодОбъёма = Новый СтандартныйПериод;
	ПериодОбъёма.ДатаНачала = ДобавитьМесяц(ДатаРасчёта, -3);
	ПериодОбъёма.ДатаОкончания = ДатаРасчёта;
	СкидкаПоОбъёму = РассчитатьСкидкуПоОбъёму(Контрагент, ПериодОбъёма);
	Если СкидкаПоОбъёму > 0 Тогда
		ЭлементОбъём = Новый Структура("ТипСкидки, Процент, Основание",
			"Объём", СкидкаПоОбъёму, "Объём закупок за 3 месяца");
		Скидки.Добавить(ЭлементОбъём);
	КонецЕсли;

	ПроверкаАкции = ПроверитьАкцию(Неопределено, ДатаРасчёта);
	Если ПроверкаАкции > 0 Тогда
		ЭлементАкция = Новый Структура("ТипСкидки, Процент, Основание",
			"Акция", ПроверкаАкции, "Действующая акция на дату расчёта");
		Скидки.Добавить(ЭлементАкция);
	КонецЕсли;

	Возврат Скидки;

КонецФункции

Функция РассчитатьСкидкуПоОбъёму(Контрагент, Период)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СУММА(ЗакупкиОбороты.СуммаОборот) КАК Сумма
		|ИЗ
		|	РегистрНакопления.Закупки.Обороты(&ДатаНач, &ДатаКон, ,
		|		Контрагент = &Контрагент) КАК ЗакупкиОбороты";

	Запрос.УстановитьПараметр("ДатаНач", Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаКон", Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат 0;
	КонецЕсли;

	Сумма = ?(Выборка.Сумма = Null, 0, Выборка.Сумма);

	Если Сумма >= 1000000 Тогда
		Возврат 7;
	ИначеЕсли Сумма >= 500000 Тогда
		Возврат 4;
	ИначеЕсли Сумма >= 100000 Тогда
		Возврат 2;
	КонецЕсли;

	Возврат 0;

КонецФункции

Функция ПроверитьАкцию(Товар, ДатаРасчёта)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Акции.ПроцентСкидки КАК ПроцентСкидки
		|ИЗ
		|	Справочник.Акции КАК Акции
		|ГДЕ
		|	Акции.ДатаНачала <= &Дата
		|	И Акции.ДатаОкончания >= &Дата
		|	И (Акции.Товар = &Товар ИЛИ Акции.Товар = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))
		|УПОРЯДОЧИТЬ ПО
		|	Акции.ПроцентСкидки УБЫВ";

	Запрос.УстановитьПараметр("Дата", ДатаРасчёта);
	Запрос.УстановитьПараметр("Товар", ?(Товар = Неопределено,
		Справочники.Номенклатура.ПустаяСсылка(), Товар));

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ПроцентСкидки;
	КонецЕсли;

	Возврат 0;

КонецФункции

Функция ОптоваяСкидкаПоДокументу(ТабличнаяЧасть)

	СуммаИтого = 0;
	Для Каждого Стр Из ТабличнаяЧасть Цикл
		СуммаИтого = СуммаИтого + Стр.ИтоговаяЦена * Стр.Количество;
	КонецЦикла;

	Если СуммаИтого >= 500000 Тогда
		Возврат 5;
	ИначеЕсли СуммаИтого >= 200000 Тогда
		Возврат 3;
	ИначеЕсли СуммаИтого >= 50000 Тогда
		Возврат 1;
	КонецЕсли;

	Возврат 0;

КонецФункции

Функция ПрименитьНакопительнуюСкидку(Контрагент, БазоваяСкидка)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СУММА(ЗакупкиОбороты.СуммаОборот) КАК Сумма
		|ИЗ
		|	РегистрНакопления.Закупки.Обороты(, , ,
		|		Контрагент = &Контрагент) КАК ЗакупкиОбороты";

	Запрос.УстановитьПараметр("Контрагент", Контрагент);

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат БазоваяСкидка;
	КонецЕсли;

	Сумма = ?(Выборка.Сумма = Null, 0, Выборка.Сумма);
	Если Сумма >= 5000000 Тогда
		Возврат БазоваяСкидка + 3;
	КонецЕсли;

	Возврат БазоваяСкидка;

КонецФункции

#КонецОбласти

#Область ПравилаЦенообразования

Функция ПрименитьПравилаЦенообразования(Цена, Скидки, Соглашение)

	ОбщийПроцент = 0;
	Для Каждого ЭлементСкидки Из Скидки Цикл
		ОбщийПроцент = ОбщийПроцент + ЭлементСкидки.Процент;
	КонецЦикла;

	ИтоговаяЦена = Цена * (1 - ОбщийПроцент / 100);

	МинимальнаяЦена = Соглашение.МинимальнаяЦена;
	Если МинимальнаяЦена > 0 И ИтоговаяЦена < МинимальнаяЦена Тогда
		ИтоговаяЦена = МинимальнаяЦена;
	КонецЕсли;

	Возврат ИтоговаяЦена;

КонецФункции

Функция ПроверитьОграничения(ИтоговаяЦена, МинимальнаяЦена, МаксимальнаяСкидка)

	Если МинимальнаяЦена > 0 И ИтоговаяЦена < МинимальнаяЦена Тогда
		Возврат МинимальнаяЦена;
	КонецЕсли;

	Если МаксимальнаяСкидка > 0 И ИтоговаяЦена < 0 Тогда
		Возврат 0;
	КонецЕсли;

	Возврат ИтоговаяЦена;

КонецФункции

Функция ОкруглитьЦену(Цена, ПравилоОкругления)

	Если ПравилоОкругления = Перечисления.ПравилаОкругления.ДоРубля Тогда
		Возврат Цел(Цена + 0.5);
	ИначеЕсли ПравилоОкругления = Перечисления.ПравилаОкругления.До10 Тогда
		Возврат Цел((Цена + 5) / 10) * 10;
	ИначеЕсли ПравилоОкругления = Перечисления.ПравилаОкругления.Психологическое99 Тогда
		Возврат Цел(Цена / 100) * 100 + 99;
	КонецЕсли;

	Возврат Цена;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедуры

Функция ПолучитьКэшЦен(Товар, ВидЦены, ДатаРасчёта)

	КэшЦен = ПараметрыСеанса.КэшЦен;
	Если КэшЦен = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Ключ = Строка(Товар.УникальныйИдентификатор()) + "|"
		+ Строка(ВидЦены.УникальныйИдентификатор()) + "|"
		+ Формат(ДатаРасчёта, "ДФ=yyyyMMdd");

	Если КэшЦен.Свойство(Ключ) Тогда
		Возврат КэшЦен[Ключ];
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Процедура ОбновитьКэшЦен(Товар, ВидЦены, ДатаРасчёта, Цена)

	КэшЦен = ПараметрыСеанса.КэшЦен;
	Если КэшЦен = Неопределено Тогда
		КэшЦен = Новый Соответствие;
	КонецЕсли;

	Ключ = Строка(Товар.УникальныйИдентификатор()) + "|"
		+ Строка(ВидЦены.УникальныйИдентификатор()) + "|"
		+ Формат(ДатаРасчёта, "ДФ=yyyyMMdd");

	КэшЦен.Вставить(Ключ, Цена);
	ПараметрыСеанса.КэшЦен = КэшЦен;

КонецПроцедуры

Процедура ЗаписатьИсториюРасчёта(ДанныеРасчёта)

	НаборЗаписей = РегистрыСведений.ИсторияРасчётаЦен.СоздатьНаборЗаписей();
	Запись = НаборЗаписей.Добавить();
	Запись.Период = ТекущаяДата();
	Запись.Товар = ДанныеРасчёта.Товар;
	Запись.Контрагент = ДанныеРасчёта.Контрагент;
	Запись.ИтоговаяЦена = ДанныеРасчёта.Цена;
	Запись.КоличествоСкидок = ДанныеРасчёта.Скидки.Количество();

	Попытка
		НаборЗаписей.Записать();
	Исключение
		ЗаписьЖурналаРегистрации(
			"Расчёт цен",
			УровеньЖурналаРегистрации.Предупреждение, ,
			ДанныеРасчёта.Товар,
			ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

Функция ПодготовитьСтруктуруРезультата()

	Результат = Новый Структура;
	Результат.Вставить("Цена", 0);
	Результат.Вставить("ПроцентСкидки", 0);
	Результат.Вставить("ПримененныеСкидки", Новый Массив);
	Результат.Вставить("Основание", "");

	Возврат Результат;

КонецФункции

Функция ПолучитьБазовуюСкидку(Договор)

	БазоваяСкидка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "СкидкаПоУмолчанию");
	Если БазоваяСкидка = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Возврат БазоваяСкидка;

КонецФункции

Функция ОграничитьМаксимальнуюСкидку(Скидка)

	МаксимальнаяСкидка = Константы.МаксимальнаяСкидкаПоУмолчанию.Получить();
	Если МаксимальнаяСкидка = 0 Тогда
		МаксимальнаяСкидка = 25;
	КонецЕсли;

	Если Скидка > МаксимальнаяСкидка Тогда
		Возврат МаксимальнаяСкидка;
	КонецЕсли;

	Если Скидка < 0 Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Скидка;

КонецФункции

Функция СвернутьПроцентСкидки(Скидки)

	Сумма = 0;
	Для Каждого ЭлементСкидки Из Скидки Цикл
		Сумма = Сумма + ЭлементСкидки.Процент;
	КонецЦикла;

	Возврат Сумма;

КонецФункции

