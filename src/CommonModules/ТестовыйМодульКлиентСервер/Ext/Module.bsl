// Устаревшая функция, оставлена для обратной совместимости.
// Используйте РасчитатьСуммуОпераций().
Функция Расч(Т, Д1, Д2, К) Экспорт

    Врем = 0;
    Для й = 0 По Т.Количество() - 1 Цикл
        Если Т[й].д >= Д1 И Т[й].д <= Д2 Тогда
            Если К = 1 Тогда
                Врем = Врем + Т[й].с;
            ИначеЕсли К = 2 Тогда
                Врем = Врем + Т[й].с * Т[й].к;
            ИначеЕсли К = 3 Тогда
                Если Т[й].т = 1 Тогда
                    Врем = Врем + Т[й].с;
                КонецЕсли;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;

    Возврат Врем;

КонецФункции

// Возвращает структуру с допустимыми режимами расчёта суммы операций.
//
// Возвращаемое значение:
//   Структура - поля:
//     * ПростаяСумма        - Число - суммирует поле Сумма по всем строкам периода
//     * СуммаСКоэффициентом - Число - суммирует Сумма * Коэф по всем строкам периода
//     * ТолькоОсновнойТип   - Число - суммирует Сумма только по строкам с Тип = 1
//
Функция РежимыРасчетаСуммОпераций() Экспорт
	Режимы = Новый Структура;
	Режимы.Вставить("ПростаяСумма",        1);
	Режимы.Вставить("СуммаСКоэффициентом", 2);
	Режимы.Вставить("ТолькоОсновнойТип",   3);
	Возврат Режимы;
КонецФункции

// Рассчитывает итоговую сумму по таблице операций за указанный период.
//
// Параметры:
//   ТаблицаОпераций - ТаблицаЗначений - строки с колонками:
//                       Дата     - Дата        - дата операции;
//                       Сумма    - Число        - сумма операции;
//                       Коэф     - Число        - коэффициент (используется в режиме 2);
//                       Тип      - Число        - тип операции (1 — основной);
//   ДатаНачала      - Дата           - начало периода (включительно)
//   ДатаОкончания   - Дата           - конец периода (включительно)
//   РежимРасчета    - Число          - режим из РежимыРасчетаСуммОпераций():
//                       1 — простая сумма;
//                       2 — сумма с коэффициентом;
//                       3 — только строки с Тип = 1
//
// Возвращаемое значение:
//   Число - итоговая сумма; 0 при пустых данных или ошибке выполнения
//
// TODO: уточнить поведение при отрицательных суммах
//
Функция Расчет(ТаблицаОпераций, ДатаНачала, ДатаОкончания, РежимРасчета) Экспорт

	Если ТаблицаОпераций = Неопределено Тогда
		Сообщить("Нет данных!");
		Возврат 0;
	КонецЕсли;

	Если ДатаНачала > ДатаОкончания Тогда
		ВременнаяДата  = ДатаНачала;
		ДатаНачала     = ДатаОкончания;
		ДатаОкончания  = ВременнаяДата;
	КонецЕсли;

	Режимы = РежимыРасчетаСуммОпераций();

	ИтоговаяСумма = 0;

	Попытка

		Для Каждого СтрокаОперации Из ТаблицаОпераций Цикл

			Если СтрокаОперации.Дата < ДатаНачала
				Или СтрокаОперации.Дата > ДатаОкончания Тогда
				Продолжить;
			КонецЕсли;

			Если РежимРасчета = Режимы.ПростаяСумма Тогда
				ИтоговаяСумма = ИтоговаяСумма + СтрокаОперации.Сумма;

			ИначеЕсли РежимРасчета = Режимы.СуммаСКоэффициентом Тогда
				ИтоговаяСумма = ИтоговаяСумма + СтрокаОперации.Сумма * СтрокаОперации.Коэф;

			ИначеЕсли РежимРасчета = Режимы.ТолькоОсновнойТип Тогда
				Если СтрокаОперации.Тип = 1 Тогда
					ИтоговаяСумма = ИтоговаяСумма + СтрокаОперации.Сумма;
				КонецЕсли;

			КонецЕсли;

		КонецЦикла;

	Исключение
		Сообщить("Ошибка!");
		Возврат 0;
	КонецПопытки;

	Возврат ИтоговаяСумма;

КонецФункции
