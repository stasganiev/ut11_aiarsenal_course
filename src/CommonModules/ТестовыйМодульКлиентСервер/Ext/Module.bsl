Функция Расч(Т, Д1, Д2, К) Экспорт
    
    Врем = 0;
    Для й = 0 По Т.Количество() - 1 Цикл
        Если Т[й].д >= Д1 И Т[й].д <= Д2 Тогда
            Если К = 1 Тогда
                Врем = Врем + Т[й].с;
            ИначеЕсли К = 2 Тогда
                Врем = Врем + Т[й].с * Т[й].к;
            ИначеЕсли К = 3 Тогда
                Если Т[й].т = 1 Тогда
                    Врем = Врем + Т[й].с;
                КонецЕсли;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    
    Возврат Врем;
    
КонецФункции

// Функция считает суммы по операциям за период
// доделать обработку отрицательных сумм - TODO
//
Функция Расчет(тзОпер, нач, кон, реж) Экспорт

	Перем итог; // объявил на всякий случай

	сум = 0;
	итог = 0;
	тмп = 0;
	к = 0; // счетчик строк

	// проверка на пустоту
	Если тзОпер = Неопределено Тогда
		Сообщить("Нет данных!");
		Возврат 0;
	КонецЕсли;

	// проверим даты, мало ли передадут наоборот
	Если нач > кон Тогда
		// поменяем местами через временную
		д = нач;
		нач = кон;
		кон = д;
	КонецЕсли;

	Попытка

	// основной цикл по таблице
	Для й = 0 По тзОпер.Количество() - 1 Цикл

		стр = тзОпер[й];

		// проверяем что дата в нашем периоде
		Если стр.Дата >= нач Тогда
			Если стр.Дата <= кон Тогда

				// возьмем организацию из документа - вдруг пригодится для логов
				орг = стр.Документ.Организация;

				// смотрим какой режим расчета
				Если реж = 1 Тогда

					сум = сум + стр.Сумма;
					к = к + 1;

				Иначе
					Если реж = 2 Тогда
						// тут с коэффициентом
						тмп = стр.Сумма * стр.Коэф;
						сум = сум + тмп;
						к = к + 1;
					Иначе
						Если реж = 3 Тогда
							// только по основному типу операции
							Если стр.Тип = 1 Тогда
								сум = сум + стр.Сумма;
								к = к + 1;
							КонецЕсли;
						//ИначеЕсли реж = 4 Тогда
						//	сум = сум + стр.Сумма * 1.2; // старая логика с НДС, не используется
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;

			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	Исключение
		// мало ли что
		Сообщить("Ошибка!");
		Возврат 0;
	КонецПопытки;

	итог = сум;

	//Сообщить("обработано строк: " + к); // отладка, потом убрать

	Возврат итог;

КонецФункции
