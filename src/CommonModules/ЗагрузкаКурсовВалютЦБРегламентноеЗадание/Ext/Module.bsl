///////////////////////////////////////////////////////////////////////////////////
// Общий модуль "ЗагрузкаКурсовВалютЦБРегламентноеЗадание"
//
// Точка входа регламентного задания загрузки курсов валют с сайта ЦБ РФ.
// Модуль намеренно отделен от прикладной логики (ЗагрузкаКурсовВалютЦБ):
// здесь только регистрация выполнения задания, разграничение прав и
// гарантия того, что задание не завершится аварийно из-за внешнего сервиса.
//
// Флаги общего модуля:
//   Клиент (управляемое приложение) = Ложь
//   Сервер                          = Истина
//   Внешнее соединение              = Истина
//   Вызов сервера                   = Ложь
//   Привилегированный               = Ложь
///////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Точка входа регламентного задания "ЗагрузкаКурсовВалютЦБ".
// Процедура не выбрасывает исключений: недоступность внешнего сервиса не должна
// приводить к аварийному завершению задания и его отключению платформой.
//
// Параметры:
//  Знач ТолькоЗагружаемыеВалюты - Булево - записывать курсы только для валют
//                                 с признаком ЗагружаетсяИзИнтернета. По умолчанию Истина.
//                                 Значение задается в параметрах регламентного задания.
//
// Пример:
//  ЗагрузкаКурсовВалютЦБРегламентноеЗадание.ЗагрузитьКурсыВалют();
//
Процедура ЗагрузитьКурсыВалют(Знач ТолькоЗагружаемыеВалюты = Истина) Экспорт

	// <security> Проверка прав и регистрация начала выполнения задания - not delete
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(
		Метаданные.РегламентныеЗадания.ЗагрузкаКурсовВалютЦБ);
	// </security>

	// <error> Верхнеуровневый перехват: задание завершается штатно при любой ошибке - not delete
	// Аварийное завершение недопустимо: платформа считает такие запуски сбойными,
	// а временная недоступность внешнего сервиса сбоем задания не является.
	Попытка

		ПараметрыЗагрузки = Новый Структура;
		ПараметрыЗагрузки.Вставить("ТолькоЗагружаемыеВалюты", ТолькоЗагружаемыеВалюты);

		Результат = ЗагрузкаКурсовВалютЦБ.ВыполнитьЗагрузку(ПараметрыЗагрузки);

		Если Не Результат.Успешно Тогда
			ЗафиксироватьНеудачныйЗапуск(Результат);
		КонецЕсли;

	Исключение

		// Сюда попадают только непредвиденные ошибки: сам механизм ошибки
		// возвращает через результат. Пустой блок Исключение недопустим -
		// иначе сбой останется незамеченным до расхождения курсов в документах.
		ИнформацияОбОшибке = ИнформацияОбОшибке();

		ЗаписьЖурналаРегистрации(
			ЗагрузкаКурсовВалютЦБКлиентСервер.ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.РегистрыСведений.КурсыВалют,
			,
			СтрШаблон(НСтр("ru = 'Регламентное задание загрузки курсов валют: непредвиденная ошибка.
				|
				|Вид сбоя: %1
				|Характер: постоянная проблема, требуется вмешательство
				|
				|Что делать:
				|Ошибка в коде механизма. Передать разработчику текст ниже.
				|
				|Диагностика:
				|%2'"),
				ЗагрузкаКурсовВалютЦБКлиентСервер.ВидыСбоев().ВнутренняяОшибка,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке)));

	КонецПопытки;
	// </error>

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Фиксирует в журнале итог неудачного запуска регламентного задания.
// Подробности сбоя механизм записал ранее; здесь фиксируется итог именно
// в разрезе задания, чтобы мониторинг видел неуспешный запуск и понимал,
// нужно ли вмешательство человека.
//
// Параметры:
//  Знач Результат - Структура - см. ЗагрузкаКурсовВалютЦБ.ВыполнитьЗагрузку().
//
Процедура ЗафиксироватьНеудачныйЗапуск(Знач Результат)

	Реакция = ЗагрузкаКурсовВалютЦБКлиентСервер.РеакцияНаСбой(Результат.ВидСбоя);

	Если Реакция.ТребуетВнимания Тогда
		// Проблема сама не пройдет либо повторяется - нужен дежурный.
		Уровень = УровеньЖурналаРегистрации.Ошибка;
		Эскалация = НСтр("ru = 'ТРЕБУЕТСЯ ВНИМАНИЕ ДЕЖУРНОГО.'");
	Иначе
		// Временная проблема на стороне сервиса: ожидается, что следующий
		// запуск по расписанию отработает штатно. Дежурного не дергаем,
		// но запись уровня Предупреждение оставляем для анализа частоты сбоев.
		Уровень = УровеньЖурналаРегистрации.Предупреждение;
		Эскалация = НСтр("ru = 'Вмешательство не требуется: ожидается восстановление
			|к следующему запуску по расписанию.'");
	КонецЕсли;

	ЗаписьЖурналаРегистрации(
		ЗагрузкаКурсовВалютЦБКлиентСервер.ИмяСобытияЖурнала(),
		Уровень,
		Метаданные.РегистрыСведений.КурсыВалют,
		,
		СтрШаблон(НСтр("ru = 'Регламентное задание завершено без загрузки курсов.
			|
			|Вид сбоя: %1
			|Характер: %2
			|%3
			|
			|Итог: %4
			|
			|Что делать:
			|%5'"),
			Результат.ВидСбоя,
			?(Реакция.Временный,
				НСтр("ru = 'временная проблема'"),
				НСтр("ru = 'постоянная проблема'")),
			Эскалация,
			Результат.ОписаниеОшибки,
			Реакция.Рекомендация));

КонецПроцедуры

#КонецОбласти
