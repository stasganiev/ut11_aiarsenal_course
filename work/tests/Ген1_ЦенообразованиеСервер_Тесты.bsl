// Тесты функции ЦенообразованиеСервер.ПолучитьИтоговуюЦенуСоСкидкой.
// Покрывают риски Р-01, Р-02, Р-03, Р-04, Р-06, Р-08, Р-09 из карты рисков.
// Фреймворк: YAxUnit. Подключается к расширению конфигурации.

#Область ОписаниеТестовогоМодуля

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты.ДобавитьТестовыйНабор("ПолучитьИтоговуюЦенуСоСкидкой");

	// Р-01: скидка 100% — цена обнуляется
	ЮТТесты.ДобавитьТест("Р01_Скидка100_ЦенаРавна0");

	// Р-02: константа МаксимальнаяСкидкаПоУмолчанию = Неопределено — потолок не работает
	ЮТТесты.ДобавитьТест("Р02_КонстантаПотолкаНеопределено_ЛюбаяСкидкаПроходит");

	// Р-03: РассчитатьСкидку возвращает отрицательный процент — цена завышается
	ЮТТесты.ДобавитьТест("Р03_ОтрицательнаяСкидка_ЦенаЗавышается");

	// Р-04: несколько активных соглашений — цена недетерминирована
	ЮТТесты.ДобавитьТест("Р04_НесколькоАктивныхСоглашений_ЦенаНедетерминирована");

	// Р-06: индивидуальная цена выше базовой — клиент переплачивает
	ЮТТесты.ДобавитьТест("Р06_ИндивидуальнаяЦенаВышеБазовой_КлиентПереплачивает");

	// Р-08: РассчитатьСкидку бросает исключение — цепочка прерывается
	ЮТТесты.ДобавитьТест("Р08_РассчитатьСкидкуВыбрасываетИсключение_ОшибкаПлатформы");

	// Р-09: СуммаЗаказа = 0 — пороговая скидка не применяется
	ЮТТесты.ДобавитьТест("Р09_СуммаЗаказа0_ПороговаяСкидкаНеПрименяется");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПеременные

Перем МОКНоменклатура;
Перем МОККонтрагент;
Перем МОКДоговор;
Перем МОКВидЦены;
Перем МОКДата;

#КонецОбласти

#Область КонтекстТестов

Процедура ПередКаждымТестом() Экспорт

	// Используем произвольные ссылки-заглушки — реальных объектов в БД не требуется,
	// так как все внешние вызовы подменяются через тестовые дубли YAxUnit.
	МОКНоменклатура = Справочники.Номенклатура.ПустаяСсылка();
	МОККонтрагент   = Справочники.Партнёры.ПустаяСсылка();
	МОКДоговор      = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	МОКВидЦены      = Справочники.ВидыЦен.ПустаяСсылка();
	МОКДата         = ТекущаяДатаСеанса();

КонецПроцедуры

#КонецОбласти

#Область Тесты

// Р-01 — скидка 100% при МаксимальнаяСкидкаПоУмолчанию = 100 даёт цену 0.
//
// Ожидаемое поведение после исправления: исключение или минимально допустимая цена.
// Тест фиксирует текущее (некорректное) поведение — возврат 0.
Процедура Р01_Скидка100_ЦенаРавна0() Экспорт

	// Arrange
	БазоваяЦена    = 5000;
	ПроцентСкидки  = 100;
	ПотолокСкидки  = 100;

	ЮТМок.Метод("ЦенообразованиеСервер.ПолучитьБазовуюЦену")
		.ВернётЗначение(БазоваяЦена);

	ЮТМок.Метод("РасчётСкидок.РассчитатьСкидку")
		.ВернётЗначение(ПроцентСкидки);

	ЮТМок.Константа("МаксимальнаяСкидкаПоУмолчанию")
		.ВернётЗначение(ПотолокСкидки);

	ЮТМок.ФункциональнаяОпция("УчитыватьИндивидуальныеЦены")
		.ВернётЗначение(Ложь);

	// Act
	ИтоговаяЦена = ЦенообразованиеСервер.ПолучитьИтоговуюЦенуСоСкидкой(
		МОКНоменклатура, МОККонтрагент, 10000, МОКВидЦены, МОКДоговор, МОКДата);

	// Assert
	// Текущее поведение: 5000 * (1 - 100/100) = 0. Должно быть исключение.
	ЮТест.ОжидаетЧто(ИтоговаяЦена).Равно(0);

КонецПроцедуры

// Р-02 — МаксимальнаяСкидкаПоУмолчанию = Неопределено: сравнение «>» возвращает Ложь,
// потолок не срабатывает, скидка 80% проходит без ограничения.
Процедура Р02_КонстантаПотолкаНеопределено_ЛюбаяСкидкаПроходит() Экспорт

	// Arrange
	БазоваяЦена   = 1000;
	ПроцентСкидки = 80;

	ЮТМок.Метод("ЦенообразованиеСервер.ПолучитьБазовуюЦену")
		.ВернётЗначение(БазоваяЦена);

	ЮТМок.Метод("РасчётСкидок.РассчитатьСкидку")
		.ВернётЗначение(ПроцентСкидки);

	// Константа не инициализирована
	ЮТМок.Константа("МаксимальнаяСкидкаПоУмолчанию")
		.ВернётЗначение(Неопределено);

	ЮТМок.ФункциональнаяОпция("УчитыватьИндивидуальныеЦены")
		.ВернётЗначение(Ложь);

	// Act
	ИтоговаяЦена = ЦенообразованиеСервер.ПолучитьИтоговуюЦенуСоСкидкой(
		МОКНоменклатура, МОККонтрагент, 10000, МОКВидЦены, МОКДоговор, МОКДата);

	// Assert
	// Текущее поведение: потолок = Неопределено → условие Ложь → скидка 80% применяется.
	// Ожидаемая цена: 1000 * (1 - 80/100) = 200.
	// Корректное поведение после исправления: должна применяться скидка не выше разумного предела.
	ЮТест.ОжидаетЧто(ИтоговаяЦена).Равно(200);

КонецПроцедуры

// Р-03 — РассчитатьСкидку возвращает −10: условие «−10 > потолок» = Ложь,
// ограничение не применяется, цена увеличивается.
Процедура Р03_ОтрицательнаяСкидка_ЦенаЗавышается() Экспорт

	// Arrange
	БазоваяЦена    = 1000;
	ПроцентСкидки  = -10;
	ПотолокСкидки  = 30;

	ЮТМок.Метод("ЦенообразованиеСервер.ПолучитьБазовуюЦену")
		.ВернётЗначение(БазоваяЦена);

	ЮТМок.Метод("РасчётСкидок.РассчитатьСкидку")
		.ВернётЗначение(ПроцентСкидки);

	ЮТМок.Константа("МаксимальнаяСкидкаПоУмолчанию")
		.ВернётЗначение(ПотолокСкидки);

	ЮТМок.ФункциональнаяОпция("УчитыватьИндивидуальныеЦены")
		.ВернётЗначение(Ложь);

	// Act
	ИтоговаяЦена = ЦенообразованиеСервер.ПолучитьИтоговуюЦенуСоСкидкой(
		МОКНоменклатура, МОККонтрагент, 10000, МОКВидЦены, МОКДоговор, МОКДата);

	// Assert
	// Текущее поведение: 1000 * (1 - (-10)/100) = 1100 — цена завышена.
	// Корректное: отрицательный процент должен игнорироваться → 1000.
	ЮТест.ОжидаетЧто(ИтоговаяЦена).Равно(1100);

КонецПроцедуры

// Р-04 — два активных соглашения для одной пары (Контрагент, Номенклатура):
// функция возвращает первую попавшуюся цену; результат недетерминирован.
// Тест фиксирует, что возвращённое значение — одно из двух ожидаемых.
Процедура Р04_НесколькоАктивныхСоглашений_ЦенаНедетерминирована() Экспорт

	// Arrange — первое из двух активных соглашений вернётся через дубль
	ИндивидуальнаяЦена1 = 900;
	БазоваяЦена         = 1000;
	ПотолокСкидки       = 30;

	ЮТМок.Метод("ЦенообразованиеСервер.ПолучитьБазовуюЦену")
		.ВернётЗначение(БазоваяЦена);

	// Дубль возвращает первую запись (900); вторая (800) не доступна через текущий код
	ЮТМок.Метод("ЦенообразованиеСервер.ПолучитьИндивидуальнуюЦену")
		.ВернётЗначение(ИндивидуальнаяЦена1);

	ЮТМок.Метод("РасчётСкидок.РассчитатьСкидку")
		.ВернётЗначение(0);

	ЮТМок.Константа("МаксимальнаяСкидкаПоУмолчанию")
		.ВернётЗначение(ПотолокСкидки);

	ЮТМок.ФункциональнаяОпция("УчитыватьИндивидуальныеЦены")
		.ВернётЗначение(Истина);

	// Act
	ИтоговаяЦена = ЦенообразованиеСервер.ПолучитьИтоговуюЦенуСоСкидкой(
		МОКНоменклатура, МОККонтрагент, 10000, МОКВидЦены, МОКДоговор, МОКДата);

	// Assert
	// Фиксируем, что код вернул первую запись. Корректное поведение: детерминированный выбор (мин/дата).
	ЮТест.ОжидаетЧто(ИтоговаяЦена).Равно(900);

КонецПроцедуры

// Р-06 — индивидуальная цена (1500) выше базовой (1200), скидки нет:
// функция применяет индивидуальную цену без проверки, клиент переплачивает.
Процедура Р06_ИндивидуальнаяЦенаВышеБазовой_КлиентПереплачивает() Экспорт

	// Arrange
	БазоваяЦена       = 1200;
	ИндивидуальнаяЦена = 1500;
	ПотолокСкидки     = 30;

	ЮТМок.Метод("ЦенообразованиеСервер.ПолучитьБазовуюЦену")
		.ВернётЗначение(БазоваяЦена);

	ЮТМок.Метод("ЦенообразованиеСервер.ПолучитьИндивидуальнуюЦену")
		.ВернётЗначение(ИндивидуальнаяЦена);

	ЮТМок.Метод("РасчётСкидок.РассчитатьСкидку")
		.ВернётЗначение(0);

	ЮТМок.Константа("МаксимальнаяСкидкаПоУмолчанию")
		.ВернётЗначение(ПотолокСкидки);

	ЮТМок.ФункциональнаяОпция("УчитыватьИндивидуальныеЦены")
		.ВернётЗначение(Истина);

	// Act
	ИтоговаяЦена = ЦенообразованиеСервер.ПолучитьИтоговуюЦенуСоСкидкой(
		МОКНоменклатура, МОККонтрагент, 10000, МОКВидЦены, МОКДоговор, МОКДата);

	// Assert
	// Текущее поведение: ИндивидуальнаяЦена > 0 → БазоваяЦена = 1500, скидка 0 → итог 1500.
	// Корректное: применять Мин(БазоваяЦена, ИндивидуальнаяЦена) = 1200.
	ЮТест.ОжидаетЧто(ИтоговаяЦена).Равно(1500);

КонецПроцедуры

// Р-08 — РасчётСкидок.РассчитатьСкидку бросает исключение:
// функция не обёрнута в Попытка, вся цепочка прерывается с ошибкой платформы.
Процедура Р08_РассчитатьСкидкуВыбрасываетИсключение_ОшибкаПлатформы() Экспорт

	// Arrange
	БазоваяЦена   = 2000;
	ПотолокСкидки = 30;

	ЮТМок.Метод("ЦенообразованиеСервер.ПолучитьБазовуюЦену")
		.ВернётЗначение(БазоваяЦена);

	// Дубль имитирует сбой внутри РасчётСкидок (сетевая ошибка, неверный параметр и т.п.)
	ЮТМок.Метод("РасчётСкидок.РассчитатьСкидку")
		.ВыброситИсключение("Ошибка соединения с системой акций");

	ЮТМок.Константа("МаксимальнаяСкидкаПоУмолчанию")
		.ВернётЗначение(ПотолокСкидки);

	ЮТМок.ФункциональнаяОпция("УчитыватьИндивидуальныеЦены")
		.ВернётЗначение(Ложь);

	// Act & Assert
	// Текущее поведение: исключение распространяется наружу.
	// Корректное: функция должна перехватить исключение и вернуть базовую цену без скидки (2000).
	ЮТест.ОжидаетЧто(
		Новый ОписаниеОповещения("ЦенообразованиеСервер.ПолучитьИтоговуюЦенуСоСкидкой",
			МОКНоменклатура, МОККонтрагент, Неопределено, МОКВидЦены, МОКДоговор, МОКДата)
	).ВызоветИсключение();

КонецПроцедуры

// Р-09 — СуммаЗаказа = 0: пороговая скидка не применяется,
// покупатель получает цену без объёмной скидки.
Процедура Р09_СуммаЗаказа0_ПороговаяСкидкаНеПрименяется() Экспорт

	// Arrange
	БазоваяЦена   = 2000;
	ПотолокСкидки = 30;

	ЮТМок.Метод("ЦенообразованиеСервер.ПолучитьБазовуюЦену")
		.ВернётЗначение(БазоваяЦена);

	// СуммаЗаказа = 0 → порог не достигнут → скидка 0%
	ЮТМок.Метод("РасчётСкидок.РассчитатьСкидку")
		.ВернётЗначение(0);

	ЮТМок.Константа("МаксимальнаяСкидкаПоУмолчанию")
		.ВернётЗначение(ПотолокСкидки);

	ЮТМок.ФункциональнаяОпция("УчитыватьИндивидуальныеЦены")
		.ВернётЗначение(Ложь);

	// Act
	СуммаЗаказа  = 0;
	ИтоговаяЦена = ЦенообразованиеСервер.ПолучитьИтоговуюЦенуСоСкидкой(
		МОКНоменклатура, МОККонтрагент, СуммаЗаказа, МОКВидЦены, МОКДоговор, МОКДата);

	// Assert
	// Текущее поведение: скидка 0% → цена 2000 вместо ожидаемых 1700 (скидка 15% за объём).
	// Клиент теряет скидку из-за того, что форма вызывает функцию до расчёта суммы строк.
	ЮТест.ОжидаетЧто(ИтоговаяЦена).Равно(2000);

КонецПроцедуры

#КонецОбласти
