
Процедура ОбработатьДокументыЗаПериод(ДатаНач, ДатаКон, Соглашение) Экспорт

	// <ВАЛИДАЦИЯ> Проверка входных параметров — НЕ УДАЛЯТЬ
	Если НЕ ЗначениеЗаполнено(ДатаНач) ИЛИ НЕ ЗначениеЗаполнено(ДатаКон) Тогда
		ВызватьИсключение "Не указан период обработки";
	КонецЕсли;

	Если ДатаНач > ДатаКон Тогда
		ВызватьИсключение "Дата начала больше даты окончания";
	КонецЕсли;
	// </ВАЛИДАЦИЯ>

	// <БЕЗОПАСНОСТЬ> Проверка прав доступа — НЕ УДАЛЯТЬ
	Если НЕ ПравоДоступа("Изменение", Метаданные.Документы.РеализацияТоваровУслуг) Тогда
		ВызватьИсключение "Недостаточно прав для изменения документов реализации";
	КонецЕсли;
	// </БЕЗОПАСНОСТЬ>

	// <ВЫБОРКА> Запрос документов за период
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Реализация.Ссылка КАК Документ,
		|	Реализация.Контрагент КАК Контрагент
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК Реализация
		|ГДЕ
		|	Реализация.Дата МЕЖДУ &ДатаНач И &ДатаКон
		|	И Реализация.СоглашениеОЦенообразовании = &Соглашение
		|	И Реализация.Проведен";

	Запрос.УстановитьПараметр("ДатаНач", ДатаНач);
	Запрос.УстановитьПараметр("ДатаКон", ДатаКон);
	Запрос.УстановитьПараметр("Соглашение", Соглашение);

	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	// </ВЫБОРКА>

	// <ОБРАБОТКА> Пересчёт цен в транзакции — ОСНОВНАЯ ЛОГИКА
	Выборка = Результат.Выбрать();

	НачатьТранзакцию();
	Попытка
		Пока Выборка.Следующий() Цикл
			ДокОбъект = Выборка.Документ.ПолучитьОбъект();
			Для Каждого СтрокаТЧ Из ДокОбъект.Товары Цикл
				НоваяЦена = РассчитатьЦену(СтрокаТЧ.Номенклатура,
					Выборка.Контрагент, Соглашение, ДокОбъект.Дата, СтрокаТЧ.Количество);
				СтрокаТЧ.Цена = НоваяЦена.Цена;
				СтрокаТЧ.Скидка = НоваяЦена.ПроцентСкидки;
			КонецЦикла;
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		// <AI-ЛОГ> Структурированный контекст ошибки расчёта цены
		КонтекстОшибки = Новый Структура;
		КонтекстОшибки.Вставить("Этап", "РасчётЦены");
		КонтекстОшибки.Вставить("Документ", Строка(ТекущийДокумент));
		КонтекстОшибки.Вставить("ПрогрессДокументов",
			Формат(НомерДокумента, "ЧГ=0") + "/" + Формат(ВсегоДокументов, "ЧГ=0"));
		КонтекстОшибки.Вставить("СтрокаТЧ",
			Формат(НомерСтроки + 1, "ЧГ=0") + "/" + Формат(КоличествоСтрок, "ЧГ=0"));
		КонтекстОшибки.Вставить("Номенклатура", Строка(СтрокаТЧ.Номенклатура));
		КонтекстОшибки.Вставить("Контрагент", Строка(Выборка.Контрагент));
		КонтекстОшибки.Вставить("Количество", СтрокаТЧ.Количество);
		КонтекстОшибки.Вставить("СтараяЦена", СтрокаТЧ.Цена);
		КонтекстОшибки.Вставить("Ошибка", ОписаниеОшибки());

		ЗаписьЖурналаРегистрации("Ценообразование.AI_Лог",
			УровеньЖурналаРегистрации.Ошибка, ,
			ТекущийДокумент,
			ЗначениеВСтрокуJSON(КонтекстОшибки));
		// </AI-ЛОГ>
		ВызватьИсключение;
	КонецПопытки;
	// </ОБРАБОТКА>

КонецПроцедуры
