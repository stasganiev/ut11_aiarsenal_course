// Тесты функции ЦенообразованиеСервер.ПолучитьИтоговуюЦенуСоСкидкой.
// Покрывают риски Р-01, Р-02, Р-04, Р-06, Р-08, Р-09 из карты рисков
// (Р-03 не воспроизводим без подмены модуля РасчётСкидок: внутренняя функция
// ОграничитьМаксимальнуюСкидку уже защищает от отрицательных значений).
//
// Фреймворк: YAxUnit. Подключается как общий модуль расширения конфигурации.
// Тесты не используют моки — все зависимости подготавливаются через реальные
// объекты конфигурации (справочники, регистры сведений, константы).

#Область ОписаниеТестовогоМодуля

Процедура ИсполняемыеСценарии(СценарииМодульногоТестирования) Экспорт

	ЮТТесты.ДобавитьТестовыйНабор("ПолучитьИтоговуюЦенуСоСкидкой")
		.ПередКаждымТестом("ПередКаждымТестом")
		.ПослеКаждогоТеста("ПослеКаждогоТеста")
		.Добавить("Р01_Скидка100_ЦенаРавна0")
		.Добавить("Р02_КонстантаПотолкаНеопределено_ЛюбаяСкидкаПроходит")
		.Добавить("Р04_НесколькоАктивныхСоглашений_ЦенаНедетерминирована")
		.Добавить("Р06_ИндивидуальнаяЦенаВышеБазовой_КлиентПереплачивает")
		.Добавить("Р08_РассчитатьСкидкуВыбрасываетИсключение_ОшибкаПлатформы")
		.Добавить("Р09_СуммаЗаказа0_ПороговаяСкидкаНеПрименяется");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПеременные

Перем Номенклатура;
Перем Контрагент;
Перем Договор;
Перем ВидЦены;
Перем ДатаТеста;
Перем СохранённаяКонстантаПотолка;

#КонецОбласти

#Область КонтекстТестов

// Готовит общие тестовые данные: справочники, договор без стартовой скидки,
// сохраняет текущее значение константы потолка для последующего восстановления.
//
// Пример:
//  Вызывается фреймворком автоматически перед каждым тестом.
Процедура ПередКаждымТестом() Экспорт

	// Дата вне декабря — исключаем сезонную акцию РасчётСкидок (+3% при Месяц=12).
	ДатаТеста = Дата(2026, 5, 15);

	Номенклатура = ЮТТестовыеДанные.СоздатьЭлемент(
		Справочники.Номенклатура, "Тест_Товар", Новый Структура);

	Контрагент = ЮТТестовыеДанные.СоздатьЭлемент(
		Справочники.Партнеры, "Тест_Клиент", Новый Структура("VIP", Ложь));

	Договор = ЮТТестовыеДанные.СоздатьЭлемент(
		Справочники.ДоговорыКонтрагентов, "Тест_Договор",
		Новый Структура("СтавкаДисконтирования, Партнер", 0, Контрагент));

	ВидЦены = ЮТТестовыеДанные.СоздатьЭлемент(
		Справочники.ВидыЦен, "Тест_ВидЦены", Новый Структура);

	СохранённаяКонстантаПотолка = Константы.МаксимальнаяСкидкаПоУмолчанию.Получить();

КонецПроцедуры

// Восстанавливает константу потолка скидки.
//
// Пример:
//  Вызывается фреймворком автоматически после каждого теста.
Процедура ПослеКаждогоТеста() Экспорт

	Константы.МаксимальнаяСкидкаПоУмолчанию.Установить(СохранённаяКонстантаПотолка);

КонецПроцедуры

#КонецОбласти

#Область Тесты

// Р-01 — Скидка 100% при потолке 100% даёт цену 0.
//
// Подготовка: договор со СтавкаДисконтирования = 100, константа потолка = 100.
// Базовая цена 5000 → 5000 * (1 − 100/100) = 0.
Процедура Р01_Скидка100_ЦенаРавна0() Экспорт

	// Arrange
	Константы.МаксимальнаяСкидкаПоУмолчанию.Установить(100);
	УстановитьСтавкуДисконтированияДоговора(Договор, 100);
	ЗаписатьБазовуюЦену(Номенклатура, ВидЦены, ДатаТеста, 5000);

	// Act
	ИтоговаяЦена = ЦенообразованиеСервер.ПолучитьИтоговуюЦенуСоСкидкой(
		Номенклатура, Контрагент, 10000, ВидЦены, Договор, ДатаТеста);

	// Assert
	// Текущее (некорректное) поведение: товар отдаётся бесплатно.
	// Корректное: должно бросаться исключение или возвращаться минимальная цена.
	ЮТест.ОжидаетЧто(ИтоговаяЦена, "Цена при скидке 100%").Равно(0);

КонецПроцедуры

// Р-02 — Константа МаксимальнаяСкидкаПоУмолчанию не задана.
//
// При Неопределено сравнение «Скидка > Неопределено» = Ложь, ограничение не срабатывает.
// Базовая цена 1000, скидка договора 80% → итог 200 руб. без проверки потолка.
Процедура Р02_КонстантаПотолкаНеопределено_ЛюбаяСкидкаПроходит() Экспорт

	// Arrange
	Константы.МаксимальнаяСкидкаПоУмолчанию.Установить(Неопределено);
	УстановитьСтавкуДисконтированияДоговора(Договор, 80);
	ЗаписатьБазовуюЦену(Номенклатура, ВидЦены, ДатаТеста, 1000);

	// Act
	ИтоговаяЦена = ЦенообразованиеСервер.ПолучитьИтоговуюЦенуСоСкидкой(
		Номенклатура, Контрагент, 10000, ВидЦены, Договор, ДатаТеста);

	// Assert
	// Текущее: 1000 * (1 − 80/100) = 200, потолок не сработал.
	// Корректное: при незаполненной константе должна применяться разумная скидка по умолчанию.
	ЮТест.ОжидаетЧто(ИтоговаяЦена, "Цена при незаполненной константе потолка").Равно(200);

КонецПроцедуры

// Р-04 — Несколько активных соглашений для одной пары (Контрагент, Номенклатура).
//
// В регистре две активных записи (900 и 800). Запрос без ПЕРВЫЕ 1 и без ORDER BY
// возвращает первую попавшуюся. Тест фиксирует, что результат — одно из двух значений.
Процедура Р04_НесколькоАктивныхСоглашений_ЦенаНедетерминирована() Экспорт

	// Arrange
	Константы.МаксимальнаяСкидкаПоУмолчанию.Установить(30);
	ВключитьИндивидуальныеЦены(Истина);
	ЗаписатьБазовуюЦену(Номенклатура, ВидЦены, ДатаТеста, 1000);
	ЗаписатьСоглашение(Контрагент, Номенклатура, 900, Истина);
	ЗаписатьСоглашение(Контрагент, Номенклатура, 800, Истина);

	// Act
	ИтоговаяЦена = ЦенообразованиеСервер.ПолучитьИтоговуюЦенуСоСкидкой(
		Номенклатура, Контрагент, 10000, ВидЦены, Договор, ДатаТеста);

	// Assert
	// Корректное поведение: детерминированный выбор (например, минимальная цена).
	// Текущее: непредсказуемо — фиксируем, что вернулось одно из двух значений.
	ВозможныеЦены = Новый Массив;
	ВозможныеЦены.Добавить(900);
	ВозможныеЦены.Добавить(800);
	ЮТест.ОжидаетЧто(ВозможныеЦены.Найти(ИтоговаяЦена), "Цена должна совпадать с одной из соглашённых")
		.НЕ_().Равно(Неопределено);

КонецПроцедуры

// Р-06 — Индивидуальная цена выше базовой: клиент переплачивает.
//
// Базовая 1200, индивидуальная 1500, ФО включена, скидки нет.
// Условие ИндивидуальнаяЦена > 0 не защищает от завышения.
Процедура Р06_ИндивидуальнаяЦенаВышеБазовой_КлиентПереплачивает() Экспорт

	// Arrange
	Константы.МаксимальнаяСкидкаПоУмолчанию.Установить(30);
	ВключитьИндивидуальныеЦены(Истина);
	ЗаписатьБазовуюЦену(Номенклатура, ВидЦены, ДатаТеста, 1200);
	ЗаписатьСоглашение(Контрагент, Номенклатура, 1500, Истина);

	// Act
	ИтоговаяЦена = ЦенообразованиеСервер.ПолучитьИтоговуюЦенуСоСкидкой(
		Номенклатура, Контрагент, 10000, ВидЦены, Договор, ДатаТеста);

	// Assert
	// Текущее: применяется индивидуальная 1500 без сравнения с базовой.
	// Корректное: Мин(БазоваяЦена, ИндивидуальнаяЦена) = 1200.
	ЮТест.ОжидаетЧто(ИтоговаяЦена, "Цена при индивидуальной выше базовой").Равно(1500);

КонецПроцедуры

// Р-08 — РасчётСкидок.РассчитатьСкидку бросает исключение.
//
// При Договор = Неопределено вызов ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Неопределено, ...)
// бросает исключение, не обёрнутое в Попытка. Цепочка ценообразования прерывается.
Процедура Р08_РассчитатьСкидкуВыбрасываетИсключение_ОшибкаПлатформы() Экспорт

	// Arrange
	Константы.МаксимальнаяСкидкаПоУмолчанию.Установить(30);
	ЗаписатьБазовуюЦену(Номенклатура, ВидЦены, ДатаТеста, 2000);

	// Act & Assert — текущее поведение: исключение распространяется наружу.
	// Корректное: функция должна перехватить исключение и вернуть базовую цену (2000).
	Попытка
		ЦенообразованиеСервер.ПолучитьИтоговуюЦенуСоСкидкой(
			Номенклатура, Контрагент, 10000, ВидЦены, Неопределено, ДатаТеста);
		ИсключениеБылоВыброшено = Ложь;
	Исключение
		ИсключениеБылоВыброшено = Истина;
	КонецПопытки;

	ЮТест.ОжидаетЧто(ИсключениеБылоВыброшено, "Должно быть выброшено исключение из РасчётСкидок").Равно(Истина);

КонецПроцедуры

// Р-09 — СуммаЗаказа = 0: пороговая скидка не применяется.
//
// Договор без стартовой скидки, клиент не VIP, дата вне декабря, СуммаЗаказа = 0.
// Все условия скидки в РасчётСкидок не выполняются → процент 0 → клиент платит полную цену.
Процедура Р09_СуммаЗаказа0_ПороговаяСкидкаНеПрименяется() Экспорт

	// Arrange
	Константы.МаксимальнаяСкидкаПоУмолчанию.Установить(30);
	УстановитьСтавкуДисконтированияДоговора(Договор, 0);
	ЗаписатьБазовуюЦену(Номенклатура, ВидЦены, ДатаТеста, 2000);

	// Act
	ИтоговаяЦена = ЦенообразованиеСервер.ПолучитьИтоговуюЦенуСоСкидкой(
		Номенклатура, Контрагент, 0, ВидЦены, Договор, ДатаТеста);

	// Assert
	// Текущее: при СуммаЗаказа = 0 пороговая скидка не активируется → цена без скидки.
	// Клиент теряет скидку, на которую рассчитывал по объёму своего реального заказа.
	ЮТест.ОжидаетЧто(ИтоговаяЦена, "Цена при нулевой сумме заказа").Равно(2000);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедуры

// Записывает базовую цену номенклатуры в регистр сведений ЦеныНоменклатуры.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - позиция, для которой устанавливается цена.
//  ВидЦены      - СправочникСсылка.ВидыЦен - вид цены.
//  Дата         - Дата - дата записи среза.
//  Цена         - Число - значение цены.
Процедура ЗаписатьБазовуюЦену(Номенклатура, ВидЦены, Дата, Цена)

	НаборЗаписей = РегистрыСведений.ЦеныНоменклатуры.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Номенклатура.Установить(Номенклатура);
	НаборЗаписей.Отбор.ВидЦены.Установить(ВидЦены);

	Запись = НаборЗаписей.Добавить();
	Запись.Период = Дата;
	Запись.Номенклатура = Номенклатура;
	Запись.ВидЦены = ВидЦены;
	Запись.Цена = Цена;

	НаборЗаписей.Записать();

КонецПроцедуры

// Записывает соглашение об индивидуальной цене в регистр СоглашенияОЦенообразовании.
//
// Параметры:
//  Контрагент         - СправочникСсылка.Партнеры - покупатель.
//  Номенклатура       - СправочникСсылка.Номенклатура - позиция.
//  ИндивидуальнаяЦена - Число - значение индивидуальной цены.
//  Активное           - Булево - признак активной записи.
Процедура ЗаписатьСоглашение(Контрагент, Номенклатура, ИндивидуальнаяЦена, Активное)

	МенеджерЗаписи = РегистрыСведений.СоглашенияОЦенообразовании.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Контрагент = Контрагент;
	МенеджерЗаписи.Номенклатура = Номенклатура;
	МенеджерЗаписи.ИндивидуальнаяЦена = ИндивидуальнаяЦена;
	МенеджерЗаписи.Активное = Активное;
	МенеджерЗаписи.Записать();

КонецПроцедуры

// Устанавливает реквизит СтавкаДисконтирования у договора.
//
// Параметры:
//  Договор - СправочникСсылка.ДоговорыКонтрагентов - изменяемый договор.
//  Ставка  - Число - значение базовой скидки в процентах.
Процедура УстановитьСтавкуДисконтированияДоговора(Договор, Ставка)

	ДоговорОбъект = Договор.ПолучитьОбъект();
	ДоговорОбъект.СтавкаДисконтирования = Ставка;
	ДоговорОбъект.Записать();

КонецПроцедуры

// Включает или выключает функциональную опцию УчитыватьИндивидуальныеЦены через одноимённую константу.
//
// Параметры:
//  Включить - Булево - целевое значение опции.
Процедура ВключитьИндивидуальныеЦены(Включить)

	Константы.УчитыватьИндивидуальныеЦены.Установить(Включить);

КонецПроцедуры

#КонецОбласти
