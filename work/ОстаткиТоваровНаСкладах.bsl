// Запрос 1: собираем номенклатуру (с учётом иерархии) во временную таблицу
ВЫБРАТЬ
	Номенклатура.Ссылка КАК Номенклатура
ПОМЕСТИТЬ ВТ_Номенклатура
ИЗ
	Справочник.Номенклатура КАК Номенклатура
ГДЕ
	Номенклатура.ЭтоГруппа = ЛОЖЬ
	И (&ГруппаНоменклатуры = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		ИЛИ Номенклатура.Ссылка В ИЕРАРХИИ (&ГруппаНоменклатуры))
;

// Запрос 2: остатки с фильтрами только в параметрах виртуальной таблицы
ВЫБРАТЬ
	ОстаткиТоваров.Номенклатура                  КАК Номенклатура,
	ОстаткиТоваров.Номенклатура.Наименование     КАК НоменклатураНаименование,
	ОстаткиТоваров.Склад                         КАК Склад,
	ОстаткиТоваров.Склад.Наименование            КАК СкладНаименование,
	СУММА(ОстаткиТоваров.ВНаличииОстаток)        КАК Количество
ИЗ
	РегистрНакопления.ТоварыНаСкладах.Остатки(
		&ДатаОстатков,
		(Склад = &Склад ИЛИ &Склад = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка))
			И Номенклатура В (ВЫБРАТЬ ВТ.Номенклатура ИЗ ВТ_Номенклатура КАК ВТ)
	) КАК ОстаткиТоваров

СГРУППИРОВАТЬ ПО
	ОстаткиТоваров.Номенклатура,
	ОстаткиТоваров.Номенклатура.Наименование,
	ОстаткиТоваров.Склад,
	ОстаткиТоваров.Склад.Наименование

ИМЕЮЩИЕ
	СУММА(ОстаткиТоваров.ВНаличииОстаток) > 0

УПОРЯДОЧИТЬ ПО
	НоменклатураНаименование
