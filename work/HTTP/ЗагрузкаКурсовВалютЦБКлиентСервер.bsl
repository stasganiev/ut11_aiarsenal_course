///////////////////////////////////////////////////////////////////////////////////
// Общий модуль "ЗагрузкаКурсовВалютЦБКлиентСервер"
//
// Клиент-серверные утилиты механизма загрузки курсов валют с сайта ЦБ РФ.
// В модуле нет обращений к базе данных: только константы механизма и
// преобразование данных из внешнего (недоверенного) формата.
//
// Флаги общего модуля:
//   Клиент (управляемое приложение) = Истина
//   Сервер                          = Истина
//   Внешнее соединение              = Истина
//   Вызов сервера                   = Ложь
//   Глобальный                      = Ложь
///////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Возвращает имя события журнала регистрации для механизма загрузки курсов.
// Используется всеми модулями механизма, чтобы записи попадали в один узел ЖР.
//
// Возвращаемое значение:
//  Строка - имя события журнала регистрации.
//
// Пример:
//  ЗаписьЖурналаРегистрации(ЗагрузкаКурсовВалютЦБКлиентСервер.ИмяСобытияЖурнала(),
//      УровеньЖурналаРегистрации.Информация, , , Комментарий);
//
Функция ИмяСобытияЖурнала() Экспорт

	Возврат НСтр("ru = 'Загрузка курсов валют ЦБ РФ'");

КонецФункции

// Возвращает параметры подключения к сервису ЦБ РФ по умолчанию.
// Значения могут быть переопределены константами информационной базы,
// см. ЗагрузкаКурсовВалютЦБ.ПараметрыПодключения().
//
// Возвращаемое значение:
//  Структура - параметры подключения:
//   * Сервер               - Строка  - имя хоста без схемы протокола.
//   * АдресРесурса         - Строка  - путь к ресурсу на сервере.
//   * ЗащищенноеСоединение - Булево  - использовать HTTPS.
//   * Таймаут              - Число   - таймаут одной попытки, секунд.
//   * КоличествоПопыток    - Число   - общее число попыток, включая первую.
//   * ПаузаМеждуПопытками  - Число   - базовая пауза между попытками, секунд.
//
// Пример:
//  Параметры = ЗагрузкаКурсовВалютЦБКлиентСервер.ПараметрыПодключенияПоУмолчанию();
//
Функция ПараметрыПодключенияПоУмолчанию() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("Сервер",               "www.cbr.ru");
	Параметры.Вставить("АдресРесурса",         "/scripts/XML_daily.asp");
	Параметры.Вставить("ЗащищенноеСоединение", Истина);
	Параметры.Вставить("Таймаут",              30);
	Параметры.Вставить("КоличествоПопыток",    3);
	Параметры.Вставить("ПаузаМеждуПопытками",  5);
	// Доля случайной добавки к паузе (джиттер). Нужна, чтобы несколько баз,
	// стартовавших по одному расписанию, не обращались к сервису синхронно
	// и не создавали лавину запросов к уже отвечающему ошибкой серверу.
	Параметры.Вставить("ДоляСлучайнойДобавки", 0.3);
	// Порог, после которого частичная загрузка считается инцидентом.
	// Если доля пропущенных валют выше - в журнал пишется Ошибка вместо Предупреждения.
	Параметры.Вставить("ДопустимаяДоляПропусков", 0.2);

	Возврат Параметры;

КонецФункции

#Область КлассификацияСбоев

// Возвращает виды сбоев механизма. Вид сбоя определяет реакцию:
// повторять или нет, с каким уровнем писать в журнал, звать ли человека.
//
// Возвращаемое значение:
//  Структура - виды сбоев (значения - строковые идентификаторы для журнала):
//   * Нет               - Строка - сбоя не было.
//   * Сеть              - Строка - сеть недоступна, DNS не разрешается, TLS не установлен.
//   * Таймаут           - Строка - сервис не ответил за отведенное время.
//   * ОшибкаЗапроса     - Строка - HTTP 4xx: проблема на нашей стороне.
//   * ОшибкаСервиса     - Строка - HTTP 5xx: проблема на стороне сервиса.
//   * ПревышенЛимит     - Строка - HTTP 429: слишком часто обращаемся.
//   * ПустойОтвет       - Строка - код 200, но тело пустое.
//   * НеверныйФормат    - Строка - код 200, но тело не разбирается или это не ValCurs.
//   * НеполныеДанные    - Строка - ответ разобран, но часть данных отбракована.
//   * ОшибкаЗаписи      - Строка - данные корректны, но не записались в базу.
//   * ВнутренняяОшибка  - Строка - непредвиденная ошибка кода.
//
// Пример:
//  ВидыСбоев = ЗагрузкаКурсовВалютЦБКлиентСервер.ВидыСбоев();
//
Функция ВидыСбоев() Экспорт

	Виды = Новый Структура;
	Виды.Вставить("Нет",              "");
	Виды.Вставить("Сеть",             "СЕТЬ");
	Виды.Вставить("Таймаут",          "ТАЙМАУТ");
	Виды.Вставить("ОшибкаЗапроса",    "ОШИБКА_ЗАПРОСА_4XX");
	Виды.Вставить("ОшибкаСервиса",    "ОШИБКА_СЕРВИСА_5XX");
	Виды.Вставить("ПревышенЛимит",    "ПРЕВЫШЕН_ЛИМИТ_429");
	Виды.Вставить("ПустойОтвет",      "ПУСТОЙ_ОТВЕТ");
	Виды.Вставить("НеверныйФормат",   "НЕВЕРНЫЙ_ФОРМАТ");
	Виды.Вставить("НеполныеДанные",   "НЕПОЛНЫЕ_ДАННЫЕ");
	Виды.Вставить("ОшибкаЗаписи",     "ОШИБКА_ЗАПИСИ");
	Виды.Вставить("ВнутренняяОшибка", "ВНУТРЕННЯЯ_ОШИБКА");

	Возврат Виды;

КонецФункции

// Возвращает описание реакции механизма на сбой указанного вида.
// Единая точка принятия решения: повторять, эскалировать, какой уровень журнала.
//
// Параметры:
//  Знач ВидСбоя - Строка - см. ВидыСбоев().
//
// Возвращаемое значение:
//  Структура - описание реакции:
//   * Повторять       - Булево - имеет ли смысл повторная попытка.
//   * Временный       - Булево - проблема ожидаемо пройдет сама.
//   * ТребуетВнимания - Булево - нужно вмешательство человека (эскалация).
//   * Действие        - Строка - краткое описание реакции для журнала.
//   * Рекомендация    - Строка - что делать дежурному.
//
// Пример:
//  Реакция = ЗагрузкаКурсовВалютЦБКлиентСервер.РеакцияНаСбой(ВидыСбоев().Сеть);
//
Функция РеакцияНаСбой(Знач ВидСбоя) Экспорт

	ВидыСбоев = ВидыСбоев();

	Реакция = Новый Структура;
	Реакция.Вставить("Повторять",       Ложь);
	Реакция.Вставить("Временный",       Ложь);
	Реакция.Вставить("ТребуетВнимания", Истина);
	Реакция.Вставить("Действие",        НСтр("ru = 'Загрузка прекращена.'"));
	Реакция.Вставить("Рекомендация",    НСтр("ru = 'Требуется анализ дежурным.'"));

	Если ВидСбоя = ВидыСбоев.Сеть Тогда
		// Сеть может лежать как временно, так и из-за смены настроек прокси или
		// правил межсетевого экрана. Отличить одно от другого автоматически нельзя,
		// поэтому повторяем, но при исчерпании попыток зовем человека.
		Реакция.Повторять       = Истина;
		Реакция.Временный       = Истина;
		Реакция.ТребуетВнимания = Истина;
		Реакция.Действие        = НСтр("ru = 'Повтор после паузы.'");
		Реакция.Рекомендация    = НСтр("ru = 'Проверить сетевую доступность www.cbr.ru с сервера 1С,
			|настройки прокси и правила межсетевого экрана. Если сеть в порядке -
			|дождаться следующего запуска по расписанию.'");

	ИначеЕсли ВидСбоя = ВидыСбоев.Таймаут Тогда
		Реакция.Повторять       = Истина;
		Реакция.Временный       = Истина;
		Реакция.ТребуетВнимания = Ложь;
		Реакция.Действие        = НСтр("ru = 'Повтор после паузы.'");
		Реакция.Рекомендация    = НСтр("ru = 'Сервис отвечает медленно. Если повторяется
			|несколько дней подряд - увеличить константу ТаймаутЗагрузкиКурсовВалют.'");

	ИначеЕсли ВидСбоя = ВидыСбоев.ОшибкаСервиса Тогда
		// 5xx - сервис жив, но временно не обслуживает. Повтор оправдан.
		Реакция.Повторять       = Истина;
		Реакция.Временный       = Истина;
		Реакция.ТребуетВнимания = Ложь;
		Реакция.Действие        = НСтр("ru = 'Повтор после паузы.'");
		Реакция.Рекомендация    = НСтр("ru = 'Проблема на стороне ЦБ РФ. Вмешательство не требуется:
			|курсы будут загружены при следующем запуске по расписанию.'");

	ИначеЕсли ВидСбоя = ВидыСбоев.ПревышенЛимит Тогда
		Реакция.Повторять       = Истина;
		Реакция.Временный       = Истина;
		Реакция.ТребуетВнимания = Ложь;
		Реакция.Действие        = НСтр("ru = 'Повтор после увеличенной паузы.'");
		Реакция.Рекомендация    = НСтр("ru = 'Сервис ограничивает частоту обращений.
			|Проверить, не запущено ли задание чаще одного раза в сутки.'");

	ИначеЕсли ВидСбоя = ВидыСбоев.ОшибкаЗапроса Тогда
		// 4xx - сервис отвечает стабильно и будет отвечать так же на любой повтор.
		// Это наша ошибка: неверный адрес, отозванный доступ, изменившийся контракт.
		Реакция.Повторять       = Ложь;
		Реакция.Временный       = Ложь;
		Реакция.ТребуетВнимания = Истина;
		Реакция.Действие        = НСтр("ru = 'Повторы прекращены: повтор не изменит результат.'");
		Реакция.Рекомендация    = НСтр("ru = 'Ошибка на нашей стороне, сама не пройдет.
			|Проверить адрес ресурса в настройках механизма и доступность страницы в браузере.
			|Возможна смена адреса сервиса на стороне ЦБ РФ.'");

	ИначеЕсли ВидСбоя = ВидыСбоев.ПустойОтвет Тогда
		// Код 200 с пустым телом - аномалия. Разово бывает при сбое на балансировщике,
		// поэтому повтор имеет смысл, но систематическое повторение - повод разбираться.
		Реакция.Повторять       = Истина;
		Реакция.Временный       = Истина;
		Реакция.ТребуетВнимания = Истина;
		Реакция.Действие        = НСтр("ru = 'Повтор после паузы.'");
		Реакция.Рекомендация    = НСтр("ru = 'Сервис ответил успешно, но не передал данные.
			|Если повторяется - проверить, не отдает ли прокси пустой ответ вместо сервиса.'");

	ИначеЕсли ВидСбоя = ВидыСбоев.НеверныйФормат Тогда
		// Классика: редирект на страницу авторизации прокси или заглушку.
		// Тело меняться не будет - повтор в рамках одного запуска бесполезен.
		Реакция.Повторять       = Ложь;
		Реакция.Временный       = Ложь;
		Реакция.ТребуетВнимания = Истина;
		Реакция.Действие        = НСтр("ru = 'Повторы прекращены: ответ не является данными сервиса.'");
		Реакция.Рекомендация    = НСтр("ru = 'Вместо данных получен документ другого формата.
			|Типовая причина - прокси или межсетевой экран вернул страницу авторизации либо заглушку.
			|Проверить, открывается ли адрес с сервера 1С без авторизации.'");

	ИначеЕсли ВидСбоя = ВидыСбоев.НеполныеДанные Тогда
		// Данные получены, часть записана. Повтор не нужен: сервис отдал то, что отдал.
		Реакция.Повторять       = Ложь;
		Реакция.Временный       = Ложь;
		Реакция.ТребуетВнимания = Истина;
		Реакция.Действие        = НСтр("ru = 'Записана корректная часть данных.'");
		Реакция.Рекомендация    = НСтр("ru = 'Проверить в журнале список отбракованных валют.
			|Если отбракованы нужные валюты - вероятно, изменился формат ответа сервиса.'");

	ИначеЕсли ВидСбоя = ВидыСбоев.ОшибкаЗаписи Тогда
		// Блокировки и конфликты записи - типично временные.
		Реакция.Повторять       = Истина;
		Реакция.Временный       = Истина;
		Реакция.ТребуетВнимания = Истина;
		Реакция.Действие        = НСтр("ru = 'Повтор записи после паузы.'");
		Реакция.Рекомендация    = НСтр("ru = 'Проверить блокировки регистра КурсыВалют
			|и права пользователя регламентных заданий на запись в него.'");

	ИначеЕсли ВидСбоя = ВидыСбоев.ВнутренняяОшибка Тогда
		Реакция.Повторять       = Ложь;
		Реакция.Временный       = Ложь;
		Реакция.ТребуетВнимания = Истина;
		Реакция.Действие        = НСтр("ru = 'Загрузка прекращена.'");
		Реакция.Рекомендация    = НСтр("ru = 'Ошибка в коде механизма. Передать разработчику
			|подробное представление ошибки из журнала регистрации.'");

	ИначеЕсли ВидСбоя = ВидыСбоев.Нет Тогда
		Реакция.ТребуетВнимания = Ложь;
		Реакция.Действие        = НСтр("ru = 'Выполнено успешно.'");
		Реакция.Рекомендация    = "";

	КонецЕсли;

	Возврат Реакция;

КонецФункции

// Определяет вид сбоя по коду состояния HTTP.
//
// Параметры:
//  Знач КодСостояния - Число - код состояния HTTP. 0 - соединение не установлено.
//
// Возвращаемое значение:
//  Строка - вид сбоя, см. ВидыСбоев().
//
// Пример:
//  ВидСбоя = ЗагрузкаКурсовВалютЦБКлиентСервер.ВидСбояПоКодуСостояния(503);
//
Функция ВидСбояПоКодуСостояния(Знач КодСостояния) Экспорт

	ВидыСбоев = ВидыСбоев();

	Если КодСостояния = 200 Тогда
		Возврат ВидыСбоев.Нет;
	КонецЕсли;

	Если КодСостояния = 0 Тогда
		// Соединение не состоялось: сеть, DNS или TLS.
		Возврат ВидыСбоев.Сеть;
	КонецЕсли;

	Если КодСостояния = 408 Тогда
		Возврат ВидыСбоев.Таймаут;
	КонецЕсли;

	Если КодСостояния = 429 Тогда
		// Формально 4xx, но реакция другая: повторять можно, увеличив паузу.
		Возврат ВидыСбоев.ПревышенЛимит;
	КонецЕсли;

	Если КодСостояния >= 400 И КодСостояния < 500 Тогда
		Возврат ВидыСбоев.ОшибкаЗапроса;
	КонецЕсли;

	Если КодСостояния >= 500 И КодСостояния < 600 Тогда
		Возврат ВидыСбоев.ОшибкаСервиса;
	КонецЕсли;

	// Коды 1xx и 3xx как итоговый ответ не ожидаются: платформа отрабатывает
	// перенаправления сама. Считаем это нарушением контракта сервиса.
	Возврат ВидыСбоев.НеверныйФормат;

КонецФункции

// Определяет вид сбоя по тексту ошибки соединения.
// Позволяет отличить таймаут от прочих сетевых ошибок: платформа не дает
// для этого отдельного кода, различить можно только по тексту.
//
// Параметры:
//  Знач ТекстОшибки - Строка - представление ошибки соединения.
//
// Возвращаемое значение:
//  Строка - вид сбоя: Таймаут либо Сеть, см. ВидыСбоев().
//
// Пример:
//  ВидСбоя = ЗагрузкаКурсовВалютЦБКлиентСервер.ВидСбояПоТекстуОшибки(ТекстОшибки);
//
Функция ВидСбояПоТекстуОшибки(Знач ТекстОшибки) Экспорт

	ВидыСбоев = ВидыСбоев();

	Если ТипЗнч(ТекстОшибки) <> Тип("Строка") Тогда
		Возврат ВидыСбоев.Сеть;
	КонецЕсли;

	ТекстДляПоиска = НРег(ТекстОшибки);

	// Признаки таймаута в сообщениях платформы и системных библиотек.
	// Список намеренно избыточен: тексты отличаются в разных ОС и версиях платформы.
	ПризнакиТаймаута = "таймаут,время ожидания,истекло,timeout,timed out,operation timed out";

	Для Каждого Признак Из СтрРазделить(ПризнакиТаймаута, ",", Ложь) Цикл
		Если СтрНайти(ТекстДляПоиска, СокрЛП(Признак)) > 0 Тогда
			Возврат ВидыСбоев.Таймаут;
		КонецЕсли;
	КонецЦикла;

	Возврат ВидыСбоев.Сеть;

КонецФункции

#КонецОбласти

// Преобразует строку из ответа сервиса в число.
// Сервис ЦБ РФ отдает дробную часть через запятую ("57,0471"), прямое
// преобразование такой строки в число средствами платформы даст 0 или ошибку.
// Дополнительно отбрасываются неразрывные пробелы - разделители групп разрядов.
//
// Параметры:
//  Знач ИсходнаяСтрока - Строка, Неопределено - значение из внешнего источника.
//
// Возвращаемое значение:
//  Число, Неопределено - число либо Неопределено, если строку разобрать не удалось.
//                        Вызывающий код обязан проверить результат на Неопределено.
//
// Пример:
//  Курс = ЗагрузкаКурсовВалютЦБКлиентСервер.ЧислоИзСтрокиВнешнегоФормата("57,0471"); // 57.0471
//
Функция ЧислоИзСтрокиВнешнегоФормата(Знач ИсходнаяСтрока) Экспорт

	// <validation> Внешние данные: тип и пустота проверяются до разбора - not delete
	Если ИсходнаяСтрока = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(ИсходнаяСтрока) = Тип("Число") Тогда
		Возврат ИсходнаяСтрока;
	КонецЕсли;

	Если ТипЗнч(ИсходнаяСтрока) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Значение = СокрЛП(ИсходнаяСтрока);
	Если ПустаяСтрока(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	// </validation>

	// <processing> Нормализация разделителей: запятая -> точка, удаление разделителей разрядов
	Значение = СтрЗаменить(Значение, Символы.НПП, "");     // неразрывный пробел
	Значение = СтрЗаменить(Значение, Символ(160),  "");    // NBSP из XML
	Значение = СтрЗаменить(Значение, " ",          "");
	Значение = СтрЗаменить(Значение, Символы.Таб,  "");
	Значение = СтрЗаменить(Значение, ",",          ".");

	// Знак выносим отдельно, чтобы не потерять его при проверке состава символов.
	Отрицательное = СтрНачинаетсяС(Значение, "-");
	Если Отрицательное Или СтрНачинаетсяС(Значение, "+") Тогда
		Значение = Сред(Значение, 2);
	КонецЕсли;

	// Строка должна состоять только из цифр и не более чем одной точки,
	// иначе Число("...") вернет непредсказуемый результат либо вызовет исключение.
	Если Не КорректноеЧисловоеПредставление(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	// </processing>

	// <error> Преобразование выполняется в защищенном блоке - not delete
	Попытка
		Результат = Число(Значение);
	Исключение
		// Формат оказался неожиданным. Возвращаем Неопределено, вызывающий код
		// зафиксирует строку в журнале регистрации и пропустит элемент.
		Возврат Неопределено;
	КонецПопытки;
	// </error>

	Возврат ?(Отрицательное, -Результат, Результат);

КонецФункции

// Преобразует дату из формата ЦБ РФ ("ДД.ММ.ГГГГ") в тип Дата.
//
// Параметры:
//  Знач ИсходнаяСтрока - Строка, Неопределено - значение атрибута Date.
//
// Возвращаемое значение:
//  Дата, Неопределено - дата либо Неопределено, если строку разобрать не удалось.
//
// Пример:
//  ДатаКурса = ЗагрузкаКурсовВалютЦБКлиентСервер.ДатаИзСтрокиВнешнегоФормата("06.08.2026");
//
Функция ДатаИзСтрокиВнешнегоФормата(Знач ИсходнаяСтрока) Экспорт

	// <validation> Проверка формата до разбора - not delete
	Если ТипЗнч(ИсходнаяСтрока) = Тип("Дата") Тогда
		Возврат ИсходнаяСтрока;
	КонецЕсли;

	Если ТипЗнч(ИсходнаяСтрока) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Значение = СокрЛП(ИсходнаяСтрока);
	Если СтрДлина(Значение) <> 10 Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Имя переменной намеренно не "ЧастиДаты": так называется системное
	// перечисление платформы (ЧастиДаты.Дата, ЧастиДаты.Время), и локальная
	// переменная с таким именем вызывает ошибку "Object field is not writable".
	КомпонентыДаты = СтрРазделить(Значение, ".", Истина);
	Если КомпонентыДаты.Количество() <> 3 Тогда
		Возврат Неопределено;
	КонецЕсли;
	// </validation>

	// <error> Разбор даты в защищенном блоке - not delete
	Попытка
		День   = Число(КомпонентыДаты[0]);
		Месяц  = Число(КомпонентыДаты[1]);
		Год    = Число(КомпонентыДаты[2]);
		// Дата(Год, Месяц, День) сама вызовет исключение на некорректных значениях,
		// например 31.02, поэтому дополнительная проверка диапазонов не требуется.
		Результат = Дата(Год, Месяц, День);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	// </error>

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверяет, что строка содержит только цифры и не более одной десятичной точки.
//
// Параметры:
//  Знач Значение - Строка - проверяемая строка без знака и разделителей разрядов.
//
// Возвращаемое значение:
//  Булево - Истина, если строку можно безопасно преобразовать в число.
//
Функция КорректноеЧисловоеПредставление(Знач Значение)

	Если ПустаяСтрока(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;

	КоличествоТочек = 0;
	КоличествоЦифр  = 0;

	Для НомерСимвола = 1 По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, НомерСимвола, 1);
		Если Символ = "." Тогда
			КоличествоТочек = КоличествоТочек + 1;
			Если КоличествоТочек > 1 Тогда
				Возврат Ложь;
			КонецЕсли;
		ИначеЕсли СтрНайти("0123456789", Символ) > 0 Тогда
			КоличествоЦифр = КоличествоЦифр + 1;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат КоличествоЦифр > 0;

КонецФункции

#КонецОбласти
