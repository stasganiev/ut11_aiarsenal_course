///////////////////////////////////////////////////////////////////////////////////
// Общий модуль "ЗагрузкаКурсовВалютЦБРегламентноеЗадание"
//
// Точка входа регламентного задания загрузки курсов валют с сайта ЦБ РФ.
// Модуль намеренно отделен от прикладной логики (ЗагрузкаКурсовВалютЦБ):
// здесь только регистрация выполнения задания, разграничение прав и
// гарантия того, что задание не завершится аварийно из-за внешнего сервиса.
//
// Флаги общего модуля:
//   Клиент (управляемое приложение) = Ложь
//   Сервер                          = Истина
//   Внешнее соединение              = Истина
//   Вызов сервера                   = Ложь
//   Привилегированный               = Ложь
///////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Точка входа регламентного задания "ЗагрузкаКурсовВалютЦБ".
// Процедура не выбрасывает исключений: недоступность внешнего сервиса не должна
// приводить к аварийному завершению задания и его отключению платформой.
//
// Параметры:
//  Знач ТолькоЗагружаемыеВалюты - Булево - записывать курсы только для валют
//                                 с признаком ЗагружаетсяИзИнтернета. По умолчанию Истина.
//                                 Значение задается в параметрах регламентного задания.
//
// Пример:
//  ЗагрузкаКурсовВалютЦБРегламентноеЗадание.ЗагрузитьКурсыВалют();
//
Процедура ЗагрузитьКурсыВалют(Знач ТолькоЗагружаемыеВалюты = Истина) Экспорт

	// <security> Проверка прав и регистрация начала выполнения задания - not delete
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(
		Метаданные.РегламентныеЗадания.ЗагрузкаКурсовВалютЦБ);
	// </security>

	// <error> Верхнеуровневый перехват: задание завершается штатно при любой ошибке - not delete
	Попытка

		ПараметрыЗагрузки = Новый Структура;
		ПараметрыЗагрузки.Вставить("ТолькоЗагружаемыеВалюты", ТолькоЗагружаемыеВалюты);

		Результат = ЗагрузкаКурсовВалютЦБ.ВыполнитьЗагрузку(ПараметрыЗагрузки);

		Если Не Результат.Успешно Тогда
			// Ошибка уже записана в журнал регистрации внутри механизма.
			// Здесь фиксируем итог именно в разрезе регламентного задания,
			// чтобы мониторинг видел неуспешный запуск.
			ЗаписьЖурналаРегистрации(
				ЗагрузкаКурсовВалютЦБКлиентСервер.ИмяСобытияЖурнала(),
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				СтрШаблон(НСтр("ru = 'Регламентное задание завершено без загрузки курсов.
					|%1'"),
					Результат.ОписаниеОшибки));
		КонецЕсли;

	Исключение

		// Сюда попадают только непредвиденные ошибки: сам механизм ошибки
		// возвращает через результат. Пустой блок Исключение недопустим -
		// иначе сбой останется незамеченным до расхождения курсов в документах.
		ИнформацияОбОшибке = ИнформацияОбОшибке();

		ЗаписьЖурналаРегистрации(
			ЗагрузкаКурсовВалютЦБКлиентСервер.ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.РегистрыСведений.КурсыВалют,
			,
			СтрШаблон(НСтр("ru = 'Непредвиденная ошибка регламентного задания загрузки курсов валют.
				|%1'"),
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке)));

	КонецПопытки;
	// </error>

КонецПроцедуры

#КонецОбласти
