///////////////////////////////////////////////////////////////////////////////////
// Модуль формы внешней обработки "ПроверкаЗагрузкиКурсовВалютЦБ"
//
// Назначение: ручная проверка работоспособности механизма загрузки курсов
// без ожидания срабатывания регламентного задания.
//
// Обработка выполняет три сценария по отдельности:
//   1. Только запрос к сервису (проверка доступности и кода состояния);
//   2. Запрос + разбор без записи в базу (проверка формата и кодировки);
//   3. Полный сценарий с записью в регистр сведений.
//
// Реквизиты формы, которые необходимо создать (см. инструкцию):
//   ТолькоЗагружаемыеВалюты - Булево
//   ДатаКурса               - Дата (состав даты: Дата)
//   Протокол                - Строка (неограниченной длины, многострочное поле)
//   РезультатРазбора        - ТаблицаЗначений на форме (см. инструкцию)
///////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ТолькоЗагружаемыеВалюты = Истина;
	ДатаКурса = НачалоДня(ТекущаяДатаСеанса());

	ВывестиПараметрыПодключения();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Сценарий 1: проверка доступности сервиса.
// Запись в базу не выполняется.
&НаКлиенте
Процедура ПроверитьДоступностьСервиса(Команда)

	ОчиститьПротокол();
	ПроверитьДоступностьСервисаНаСервере();

КонецПроцедуры

// Сценарий 2: запрос и разбор ответа без записи в регистр.
&НаКлиенте
Процедура ПроверитьРазборОтвета(Команда)

	ОчиститьПротокол();
	ПроверитьРазборОтветаНаСервере();

КонецПроцедуры

// Сценарий 3: полный цикл с записью в регистр сведений КурсыВалют.
&НаКлиенте
Процедура ВыполнитьПолнуюЗагрузку(Команда)

	ТекстВопроса = НСтр("ru = 'Курсы будут записаны в регистр сведений ""Курсы валют"".
		|Продолжить?'");

	ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьПолнуюЗагрузкуЗавершение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПолнуюЗагрузкуЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ОчиститьПротокол();
	ВыполнитьПолнуюЗагрузкуНаСервере();

КонецПроцедуры

// Имитация разбора на заранее заданном фрагменте XML.
// Позволяет проверить обработку запятой, номинала и отсутствующих полей
// без обращения к внешнему сервису - работает и на закрытом контуре.
&НаКлиенте
Процедура ПроверитьРазборНаТестовомXML(Команда)

	ОчиститьПротокол();
	ПроверитьРазборНаТестовомXMLНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВывестиПараметрыПодключения()

	Параметры = ЗагрузкаКурсовВалютЦБ.ПараметрыПодключения();

	ДобавитьВПротокол(СтрШаблон(
		НСтр("ru = 'Параметры подключения:
			|  Сервер: %1
			|  Ресурс: %2
			|  HTTPS: %3
			|  Таймаут, с: %4
			|  Попыток: %5
			|  Пауза между попытками, с: %6'"),
		Параметры.Сервер,
		Параметры.АдресРесурса,
		?(Параметры.ЗащищенноеСоединение, НСтр("ru = 'да'"), НСтр("ru = 'нет'")),
		Параметры.Таймаут,
		Параметры.КоличествоПопыток,
		Параметры.ПаузаМеждуПопытками));

КонецПроцедуры

&НаСервере
Процедура ПроверитьДоступностьСервисаНаСервере()

	НачалоЗамера = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Ответ = ЗагрузкаКурсовВалютЦБ.ПолучитьДанныеСервиса();

	Длительность = (ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗамера) / 1000;

	Если Ответ.Успешно Тогда
		ДобавитьВПротокол(СтрШаблон(
			НСтр("ru = 'УСПЕХ. Код состояния: %1. Размер ответа, байт: %2. Время, с: %3'"),
			Ответ.КодСостояния,
			Формат(Ответ.Содержимое.Размер(), "ЧГ=0"),
			Формат(Длительность, "ЧДЦ=3; ЧГ=0")));
	Иначе
		ДобавитьВПротокол(СтрШаблон(
			НСтр("ru = 'ОШИБКА. Код состояния: %1. Время, с: %2
				|%3'"),
			Ответ.КодСостояния,
			Формат(Длительность, "ЧДЦ=3; ЧГ=0"),
			Ответ.ОписаниеОшибки));
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПроверитьРазборОтветаНаСервере()

	Ответ = ЗагрузкаКурсовВалютЦБ.ПолучитьДанныеСервиса();

	Если Не Ответ.Успешно Тогда
		ДобавитьВПротокол(СтрШаблон(
			НСтр("ru = 'Сервис недоступен, разбор не выполнялся.
				|%1'"),
			Ответ.ОписаниеОшибки));
		Возврат;
	КонецЕсли;

	ВывестиРезультатРазбора(ЗагрузкаКурсовВалютЦБ.РазобратьОтветСервиса(Ответ.Содержимое));

КонецПроцедуры

&НаСервере
Процедура ПроверитьРазборНаТестовомXMLНаСервере()

	// Контрольный набор проверяет узкие места разбора:
	//   AUD - обычная валюта, запятая в качестве разделителя;
	//   JPY - номинал 100: игнорирование дало бы ошибку в 100 раз;
	//   XXX - отсутствует Nominal, элемент должен быть пропущен;
	//   YYY - нечисловое значение курса, элемент должен быть пропущен;
	//   ZZZ - нулевой курс, элемент должен быть пропущен.
	ТестовыйXML =
	"<?xml version=""1.0"" encoding=""windows-1251""?>
	|<ValCurs Date=""06.08.2026"" name=""Foreign Currency Market"">
	|	<Valute ID=""R01010"">
	|		<NumCode>036</NumCode><CharCode>AUD</CharCode><Nominal>1</Nominal>
	|		<Name>Австралийский доллар</Name><Value>57,0471</Value><VunitRate>57,0471</VunitRate>
	|	</Valute>
	|	<Valute ID=""R01820"">
	|		<NumCode>392</NumCode><CharCode>JPY</CharCode><Nominal>100</Nominal>
	|		<Name>Японских иен</Name><Value>54,1234</Value><VunitRate>0,541234</VunitRate>
	|	</Valute>
	|	<Valute ID=""R09999"">
	|		<NumCode>999</NumCode><CharCode>XXX</CharCode>
	|		<Name>Без номинала</Name><Value>10,0</Value>
	|	</Valute>
	|	<Valute ID=""R09998"">
	|		<NumCode>998</NumCode><CharCode>YYY</CharCode><Nominal>1</Nominal>
	|		<Name>Нечисловой курс</Name><Value>н/д</Value>
	|	</Valute>
	|	<Valute ID=""R09997"">
	|		<NumCode>997</NumCode><CharCode>ZZZ</CharCode><Nominal>1</Nominal>
	|		<Name>Нулевой курс</Name><Value>0,0000</Value>
	|	</Valute>
	|</ValCurs>";

	ДобавитьВПротокол(НСтр("ru = 'Разбор контрольного XML (обращения к сервису нет).
		|Ожидаемый результат: разобрано 2 (AUD, JPY), пропущено 3 (XXX, YYY, ZZZ).'"));

	ВывестиРезультатРазбора(ЗагрузкаКурсовВалютЦБ.РазобратьОтветСервиса(ТестовыйXML));

КонецПроцедуры

&НаСервере
Процедура ВывестиРезультатРазбора(ДанныеРазбора)

	РезультатРазбора.Очистить();

	Если Не ДанныеРазбора.Успешно Тогда
		ДобавитьВПротокол(СтрШаблон(
			НСтр("ru = 'ОШИБКА РАЗБОРА: %1'"), ДанныеРазбора.ОписаниеОшибки));
		Возврат;
	КонецЕсли;

	ДобавитьВПротокол(СтрШаблон(
		НСтр("ru = 'Разбор выполнен.
			|  Дата курсов: %1
			|  Разобрано валют: %2
			|  Пропущено элементов: %3'"),
		Формат(ДанныеРазбора.ДатаКурса, "ДФ=dd.MM.yyyy"),
		ДанныеРазбора.Курсы.Количество(),
		ДанныеРазбора.Пропущено));

	Для Каждого СтрокаКурса Из ДанныеРазбора.Курсы Цикл
		НоваяСтрока = РезультатРазбора.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКурса);
		// Курс за единицу валюты - именно та величина, которую видит пользователь.
		// Расхождение с колонкой "Курс" при Кратность > 1 - признак того,
		// что номинал учтен корректно.
		НоваяСтрока.КурсЗаЕдиницу = СтрокаКурса.Курс / СтрокаКурса.Кратность;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ВыполнитьПолнуюЗагрузкуНаСервере()

	ПараметрыЗагрузки = Новый Структура;
	ПараметрыЗагрузки.Вставить("ТолькоЗагружаемыеВалюты", ТолькоЗагружаемыеВалюты);
	Если ЗначениеЗаполнено(ДатаКурса) Тогда
		ПараметрыЗагрузки.Вставить("ДатаКурса", ДатаКурса);
	КонецЕсли;

	Результат = ЗагрузкаКурсовВалютЦБ.ВыполнитьЗагрузку(ПараметрыЗагрузки);

	ДобавитьВПротокол(СтрШаблон(
		НСтр("ru = '%1
			|  Дата курсов: %2
			|  Получено от сервиса: %3
			|  Записано в регистр: %4
			|  Пропущено: %5
			|  %6'"),
		?(Результат.Успешно, НСтр("ru = 'ЗАГРУЗКА ВЫПОЛНЕНА'"), НСтр("ru = 'ЗАГРУЗКА НЕ ВЫПОЛНЕНА'")),
		Формат(Результат.ДатаКурса, "ДФ=dd.MM.yyyy"),
		Результат.ВсегоПолучено,
		Результат.Записано,
		Результат.Пропущено,
		Результат.ОписаниеОшибки));

	ДобавитьВПротокол(НСтр("ru = 'Подробности - в журнале регистрации,
		|событие ""Загрузка курсов валют ЦБ РФ"".'"));

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьПротокол()

	Протокол = "";

КонецПроцедуры

&НаСервере
Процедура ДобавитьВПротокол(Знач Текст)

	Отметка = Формат(ТекущаяДатаСеанса(), "ДФ=HH:mm:ss");

	Если Не ПустаяСтрока(Протокол) Тогда
		Протокол = Протокол + Символы.ПС + Символы.ПС;
	КонецЕсли;

	Протокол = Протокол + "[" + Отметка + "] " + Текст;

КонецПроцедуры

#КонецОбласти
